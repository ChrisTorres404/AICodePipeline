# Project binding — created per target project, never committed to the pipeline
pipeline.config.sh

# Work done while dogfooding the pipeline on itself belongs to whoever ran it
Workspace/

.DS_Store
*.swp

# Build output
/dist/

__pycache__/
# playbooks are user content; only the scaffold is tracked
playbooks/*/
!playbooks/README.md
!playbooks/INDEX.md

# reference material under extraction — never committed
Examples_for_claude/

# the owner's private folders, whatever they are called — never committed (a clone has no .git/info/exclude)
/Private-*/
