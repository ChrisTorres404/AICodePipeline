#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# acp — AICodePipeline front door
#
# One command on PATH; everything else is a subcommand that forwards to the
# individual driver. The drivers remain standalone scripts you can call or
# edit directly.
#
#   acp init <path> [--name N] [--domain D] [--playbook P]  new project from nothing
#   acp install <path>                                   add to an existing project
#   acp layout [--check] --pipeline-dir P --code-dir C   set pipeline.config.sh for the P/ (pipeline) + C/ (code) layout
#   acp doctor [path]                                    is the install healthy?
#   acp doctor --gitignore-hint [path]                   the .gitignore lines that keep secret files out of git
#   acp baseline [--command '<cmd>'] [--dry-run]         run the project's own tests once and record the first measurement
#   acp intake [status|inventory]                        the work orders a project completes before it is operational
#   acp kb status|bind|impact                            the knowledge base: what describes the code, and whether it still does
#   acp migrate plan [--project D] [--repo D] [--replace] plan the move into app/ and acp/: writes .acp-migration/, moves nothing
#   acp migrate backup --to D [--project D] | --check [--project D] [--repo D]    the whole project as one checked tar outside it, before anything moves
#   acp migrate answer <n> <option> | <n> --folder D [--project D]   record the owner's answer to one question of the plan
#   acp migrate apply [--project D]                      the restructure, as one commit; run from an ACP source clone
#   acp migrate rollback [--project D] [--archive F]     put a migrated project back as its backup holds it
#   acp wo|bug|playbook|sanitize|detect-stack <args>     forward to the driver
#   acp check [--staged|--since REF|--paths P...]        the rules over a set of files; blocks on secrets,
#                                                        weakened config, closeouts without evidence
#   acp agent <name>                                     print a specialist's definition (any tool can read it)
#   acp agents [--area A]                                list specialists, or the ones routed for an area
#   acp commands | acp command <name>                    the slash commands as instructions any agent can read
#   acp skills | acp skill <name>                        the skills, the same way
#   acp ci github                                        add a workflow that runs the rules on every pull request
#   acp publish-check [--identity E] [--deny RX]         before a first push: the whole history of every branch, read for
#                                                        secrets, junk, identities, a second pipeline copy and old branches
#   acp lint [--strict]                                  validate agents, skills, hooks, rules
#   acp eval list|run [name]|new <name>                  the pipeline's own behavioural evaluations
#   acp test [--live]                                    every check in one command (lint, sanitize, evals, plugin; --live adds real sessions)
#   acp build-plugin [--version X]                       assemble dist/plugin/
#   acp version
#   acp help [command]
# ---------------------------------------------------------------------------
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
BIN="$ROOT/bin"
VERSION="1.5.0"

usage() { sed -n '3,/^# -\{20,\}$/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//'; }

bound_seconds() { # <value> <variable name> -> effective seconds, complaining on stdout if the value was unusable
  local v="$1" name="$2"
  case "$v" in
    ''|*[!0-9]*|0) echo "  ($name='$v' is not a positive number of seconds; using 120)"; echo 120;;
    *) echo "$v";;
  esac
}

run_bounded() { # <seconds> <command...> -> the command's status, 124 on timeout, 2 if the bound is unusable
  # A check that never returns is not a passing check. macOS ships no timeout(1)
  # and bash 3.2 has no wait -n, so this waits by hand and escalates to KILL.
  #
  # A bound that is not a positive integer is refused outright and nothing is
  # started. Quietly substituting a default would launch a long-running command
  # under a bound the caller never asked for, which is the failure this function
  # exists to prevent. Callers that take the value from a user turn it into a
  # number first, out loud: see bound_seconds.
  #
  # The command runs in its own process group and the whole group is signalled,
  # because killing only the immediate child leaves whatever it spawned running.
  # Only the group this function created is ever signalled.
  local secs="${1:-}"; shift || true
  case "$secs" in
    ''|*[!0-9]*) echo "run_bounded: '$secs' is not a number of seconds; nothing was run" >&2; return 2;;
  esac
  [ "$secs" -gt 0 ] 2>/dev/null || { echo "run_bounded: a bound of $secs seconds is not a bound; nothing was run" >&2; return 2; }
  [ "$#" -gt 0 ] || { echo "run_bounded: no command given" >&2; return 2; }
  (
    set -m                      # each background job gets its own process group
    "$@" >/dev/null 2>&1 &
    pid=$!; waited=0
    set +m
    while kill -0 "$pid" 2>/dev/null; do
      if [ "$waited" -ge "$secs" ]; then
        kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
        sleep 1
        kill -KILL "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null
        wait "$pid" 2>/dev/null
        exit 124
      fi
      sleep 1; waited=$((waited + 1))
    done
    wait "$pid"
  ) 2>/dev/null
}

# Secret files never enter git. Each probe below is a name such a file has; the project's own .gitignore
# files must ignore it, which git check-ignore says (the file is never read as text). The global excludes
# file and .git/info/exclude do not count: a clone carries neither. The owner's file is never written;
# the lines that would close a gap are printed. One rule per line: probe|the lines that ignore it.
SECRET_RULES='.env|.env
.env.production|.env.*,!.env.example,!.env.sample,!.env.template
x.pem|*.pem
x.key|*.key
x.p12|*.p12
x.pfx|*.pfx
id_rsa|id_rsa*,!*.pub
id_ed25519|id_ed25519*,!*.pub
id_ecdsa|id_ecdsa*,!*.pub'
gi_ignored() { # project path -> 0 when one of the project's own .gitignore files ignores path
  local src
  src="$(git -C "$1" -c core.excludesFile=/dev/null check-ignore -v --no-index -- "$2" 2>/dev/null)" || return 1
  case "${src%%:*}" in /*|.git/*|*/.git/*) return 1;; esac   # info/exclude, or a file outside the project
  # source:line:pattern<TAB>path; with -v a negation that matched is shown too, and it lets the file in
  src="${src#*:}"; src="${src#*:}"; case "$src" in '!'*) return 1;; esac
  return 0
}
gi_gaps() { # project -> "probe<TAB>lines" for each secret probe its .gitignore lets into git, at the root and in CODE_DIR
  local t="$1" code="" rule probe where
  if [ -f "$t/pipeline.config.sh" ]; then code="$(sed -n 's/^export CODE_DIR="\([^"]*\)".*/\1/p' "$t/pipeline.config.sh" | head -1)"; fi
  case "$code" in ''|.|./|/*|*'$'*|*..*) code="";; esac   # only a plain folder inside the project is probed too
  while IFS= read -r rule; do
    probe="${rule%%|*}"
    for where in "" ${code:+"${code%/}/"}; do
      gi_ignored "$t" "$where$probe" || { printf '%s\t%s\n' "$where$probe" "${rule#*|}"; break; }
    done
  done <<EOF_RULES
$SECRET_RULES
EOF_RULES
}
gi_block() { # project -> the lines to add to its .gitignore, each once, where it last falls: a negation
  # (!*.pub) after every line it answers, since the last line that matches decides
  gi_gaps "$1" | cut -f2 | tr ',' '\n' | awk 'NF { line[++n] = $0; last[$0] = n } END { for (i = 1; i <= n; i++) if (last[line[i]] == i) print line[i] }'
}
gitignore_hint() {
  local t="${1:-$PWD}"
  t="$(cd "$t" 2>/dev/null && pwd)" || { echo "acp doctor --gitignore-hint: ${1:-.} is not a directory" >&2; return 2; }
  git -C "$t" rev-parse --show-toplevel >/dev/null 2>&1 || { echo "acp doctor --gitignore-hint: $t is not a git repository" >&2; return 2; }
  gi_block "$t"
}

doctor() {
  local target="${1:-$PWD}" fail=0 warn=0
  target="$(cd "$target" 2>/dev/null && pwd)" || { echo "acp doctor: $1 is not a directory" >&2; return 2; }
  ok()   { printf '  \033[32mPASS\033[0m  %s\n' "$*"; }
  bad()  { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; fail=$((fail+1)); }
  meh()  { printf '  \033[33mWARN\033[0m  %s\n' "$*"; warn=$((warn+1)); }
  echo "acp doctor — $target"; echo
  for t in python3 perl git; do command -v "$t" >/dev/null && ok "$t available" || bad "$t not found on PATH"; done
  local cfg="$target/pipeline.config.sh" proot=""
  if [ -f "$cfg" ]; then
    ok "pipeline.config.sh present"
    for v in PROJECT_NAME PROJECT_SLUG PIPELINE_ROOT WORKORDERS_DIR BUGS_DIR TESTING_DIR SESSIONS_DIR; do
      grep -qE "^export $v=\"[^\"]+\"" "$cfg" && [ "$(sed -n "s/^export $v=\"\([^\"]*\)\".*/\1/p" "$cfg")" != "" ] || bad "$v is empty in pipeline.config.sh"
    done
    grep -q 'PROJECT_NAME="My Platform"' "$cfg" && meh "PROJECT_NAME still has the example value"
    proot="$(sed -n 's/^export PIPELINE_ROOT="\([^"]*\)".*/\1/p' "$cfg")"
  else
    meh "no pipeline.config.sh — drivers fall back to git root + default layout (plugin mode)"
    proot=".aicodepipeline"
  fi
  local dest="$target/$proot" profile="standard"
  [ -f "$dest/.profile" ] && profile="$(cat "$dest/.profile")"
  if [ ! -f "$cfg" ] && [ ! -d "$dest" ]; then
    meh "no pipeline install here — plugin mode (commands, agents, skills, hooks come from the plugin); install checks skipped"
    git -C "$target" rev-parse --show-toplevel >/dev/null 2>&1 && ok "git repository" || meh "not a git repository"
    echo; echo "plugin mode — $warn note(s)"; return 0
  fi
  if [ -d "$dest" ]; then
    ok "pipeline installed at $proot/"
    for b in acp wo bug playbook sanitize detect-stack stack-specialist; do [ -x "$dest/bin/$b" ] && ok "bin/$b executable" || bad "bin/$b missing or not executable (re-run install)"; done
    for h in "$dest"/core/hooks/*.py "$dest"/core/hooks/*.sh; do [ -x "$h" ] || bad "hook $(basename "$h") not executable"; done
    ok "profile: $profile"
    local unres vre="PROJECT_NAME|PROJECT_SLUG|PROJECT_DOMAIN|GITHUB_REPO|PROJECT_ROOT|PIPELINE_ROOT|WORKSPACE_DIR|DOCS_DIR|WORKORDERS_DIR|BUGS_DIR|TESTING_DIR|SESSIONS_DIR|API_APP|ADMIN_APP|PORTAL_APP|DEV_APP|WEB_APP|SDK_PKG|DB_NAME|CLI_NAME|API_BASE_URL|WEB_ORIGIN|STACK_SECTION"
    unres="$(grep -rhoE "\{\{(${vre})\}\}" "$dest/core" "$dest/harness" --exclude-dir=project --exclude-dir=templates 2>/dev/null | sort -u | tr '\n' ' ' || true)"
    local pbd="$dest/playbooks" prc=0 tp; tp="$(cd "$target" && pwd -P)"   # the playbooks folder as the drivers find it, from the config alone
    [ ! -f "$cfg" ] || pbd="$(env -u PLAYBOOKS_DIR -u PACKS_DIR -u CODE_DIR "$BIN/playbook" where --project "$target" 2>&1)" || prc=$?
    case "$prc" in
      0) local pbs="${pbd#"$tp"/}"; pbs="${pbs#"$target"/}"   # shown relative to the project
         if [ -d "$pbd" ]; then ok "playbooks folder present ($pbs)"; else bad "no playbooks folder at $pbs (re-run install)"; fi;;
      2) meh "PLAYBOOKS_DIR is not set as plain data in pipeline.config.sh; the playbooks folder is not checked";;
      *) bad "$pbd";;
    esac
    [ -d "$dest/packs" ] && meh "packs/ is the old name for playbooks/; re-run install to move it" || true
    [ -z "$unres" ] && ok "no unresolved template variables" || bad "unresolved variables: $unres"
  else
    bad "no pipeline at $proot/ — run: acp install $target"
  fi
  local st="$target/.claude/settings.json"
  if [ -f "$st" ]; then
    if python3 -c "import json,sys; d=json.load(open('$st')); h=d.get('hooks',{}); sys.exit(0 if any('acp:' in x.get('command','') for ev in h.values() for e in ev for x in e.get('hooks',[])) else 1)" 2>/dev/null; then
      ok "hooks wired in .claude/settings.json"
    elif [ "$profile" = "minimal" ]; then ok "no hooks (minimal profile)"
    else bad "no acp: hooks in .claude/settings.json"; fi
  else bad ".claude/settings.json missing"; fi
  # A count that cannot tell 162 working skills from 161 and one broken is not
  # worth printing. Lint opens every file; the count is reported with its result.
  local lrc=0 lline; lline="$("$dest/bin/lint" "$dest" 2>/dev/null | tail -1)" || lrc=$?
  local lerr; lerr="$(printf '%s' "$lline" | sed -n 's/^\([0-9]*\) error(s).*/\1/p')"; lerr="${lerr:-?}"
  local nag nsk; nag="$(ls "$target/.claude/agents" 2>/dev/null | wc -l | tr -d ' ')"; nsk="$(ls "$target/.claude/skills" 2>/dev/null | wc -l | tr -d ' ')"
  # What Claude Code loads is the copy under .claude/, so that copy is what has to
  # parse. The same frontmatter rule the linter applies, over those files.
  local bad_fm; bad_fm="$(python3 - "$target/.claude/agents" "$target/.claude/skills" <<'PYEOF'
import os, re, sys
def yaml_ok(fm):
    try:
        import yaml
        try: yaml.safe_load(fm); return True
        except Exception: return False
    except ImportError: pass
    prev_block = False
    for line in fm.split("\n"):
        if not line.strip(): continue
        if line.startswith((" ", "\t")):
            # An indented line belongs to a key whose value was empty or a block marker. Under a plain value,
            # `  key: value` is what YAML rejects ("mapping values are not allowed here").
            if not prev_block and not re.match(r"^\s+- ", line): return False
            continue
        m = re.match(r"^([A-Za-z_][\w-]*):(\s*(.*))?$", line)
        if not m: return False
        val = (m.group(3) or "").strip()
        if re.match(r"^[>|][-+]?\S", val): return False
        prev_block = val in (">", ">-", "|", "|-", ">+", "|+", "")
    return True
bad = []
for root in sys.argv[1:]:
    for d, _, files in os.walk(root):
        for f in files:
            if not f.endswith(".md"): continue
            p = os.path.join(d, f)
            try: t = open(p, encoding="utf-8", errors="ignore").read()
            except OSError: continue
            m = re.match(r"^---\n(.*?)\n---\n", t, re.S)
            if m and not yaml_ok(m.group(1)): bad.append(os.path.relpath(p, os.path.dirname(root)))
print(len(bad)); [print("  " + b) for b in bad[:5]]
PYEOF
)"
  local nbad; nbad="$(printf '%s\n' "$bad_fm" | head -1)"; nbad="${nbad:-0}"
  if [ -d "$target/.claude/agents" ] && [ -d "$target/.claude/skills" ]; then
    if [ "$nbad" != 0 ]; then bad "agents: $nag, skills: $nsk — $nbad definition(s) under .claude/ do not parse and will never fire:$(printf '%s\n' "$bad_fm" | tail -n +2 | tr '\n' ' ')"
    elif [ "$lerr" = 0 ]; then ok "agents: $nag, skills: $nsk — every definition parses (lint: $lline)"
    else bad "agents: $nag, skills: $nsk — lint reports $lerr error(s); a definition that does not parse is installed and never fires:  $dest/bin/lint $dest"; fi
  else
    [ -d "$target/.claude/agents" ] || bad "no .claude/agents"; [ -d "$target/.claude/skills" ] || bad "no .claude/skills"
  fi
  [ -d "$target/.claude/rules" ] && ok "rules: $(ls "$target/.claude/rules" | tr '\n' ' ')" || meh "no .claude/rules (plugin mode: copy sets from rules/)"
  local ins=""; for c in AGENTS.md CLAUDE.md; do [ -f "$target/$c" ] && { ins="$c"; break; }; done
  if [ -n "$ins" ]; then
    grep -q '{{' "$target/$ins" && bad "$ins has unresolved {{variables}}" || ok "$ins present"
    # Instructions are authored content and are never rewritten by install, so a
    # workspace that moved leaves them pointing at folders that no longer exist.
    local wod2; wod2="$(sed -n 's/^export WORKORDERS_DIR="\([^"]*\)".*/\1/p' "$cfg" 2>/dev/null)"; wod2="${wod2:-Workspace/Docs/WorkOrders}"
    grep -qF "$wod2" "$target/$ins" 2>/dev/null || meh "$ins never mentions the configured work-order directory ($wod2); if the layout changed since it was written, its paths are stale — update it"
    grep -q '_(the command)_\|_(fill in)_\|_(empty project' "$target/$ins" && meh "$ins Project Specifics still has placeholders — run: $proot/bin/detect-stack . --write"
  else meh "no instructions file (AGENTS.md); agents get no methodology — re-run install"; fi
  local wod; wod="$(sed -n 's/^export WORKORDERS_DIR="\([^"]*\)".*/\1/p' "$cfg" 2>/dev/null)"; wod="${wod:-Workspace/Docs/WorkOrders}"
  [ -d "$target/$wod" ] && ok "work orders: $(ls -d "$target/$wod"/WO-* 2>/dev/null | wc -l | tr -d ' ')" || meh "no work-order directory yet ($wod)"
  if git -C "$target" rev-parse --show-toplevel >/dev/null 2>&1; then
    if git -C "$target" rev-parse HEAD >/dev/null 2>&1; then
      ok "git repository ($(git -C "$target" rev-parse --short HEAD), $(git -C "$target" status --porcelain 2>/dev/null | wc -l | tr -d ' ') uncommitted path(s))"
      # Evidence is bound to a source state. Without a remote there is nothing to
      # say whether this directory is the project of record.
      if git -C "$target" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
        local ab; ab="$(git -C "$target" rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null || echo '? ?')"
        ok "remote: behind ${ab%% *}, ahead ${ab##* } of $(git -C "$target" rev-parse --abbrev-ref '@{upstream}')"
      elif [ -n "$(git -C "$target" remote 2>/dev/null)" ]; then meh "a remote is configured but this branch tracks nothing; the pushed tree may not be this tree"
      else meh "no remote: nothing says whether this directory is the project of record"; fi
    else
      meh "git repository with no commits yet: evidence binds to a source state, and there is none to return to — commit first"
    fi
    # The tool hook cannot see a message that arrives by file or editor; git can.
    # Ask git where it looks, rather than inferring: a linked worktree and
    # core.hooksPath both put the hook somewhere the obvious guess is wrong.
    local cm; cm="$(cd "$target" && git rev-parse --git-path hooks/commit-msg 2>/dev/null || true)"
    case "$cm" in ''|/*) ;; *) cm="$target/$cm";; esac
    if [ -z "$cm" ] || [ ! -f "$cm" ]; then
      meh "no commit-msg hook; a reference to a work order that does not exist can still be committed by file — re-run install to wire it"
    elif ! grep -q 'acp:commit-msg:wo-reference' "$cm" 2>/dev/null; then
      meh "commit-msg hook is not the pipeline's, so traceability only covers messages typed into the command; chain the check into your hook (README: The commit-msg hook)"
    elif [ ! -x "$cm" ]; then
      # git skips a hook it cannot execute, and says so only in a warning nobody reads.
      bad "commit-msg hook is present but not executable, so git ignores it and phantom references commit freely: chmod +x $cm"
    else
      ok "commit-msg hook wired and executable (traceability holds for messages given by file or editor)"
    fi
    local pc; pc="$(cd "$target" && git rev-parse --git-path hooks/pre-commit 2>/dev/null || true)"
    case "$pc" in ''|/*) ;; *) pc="$target/$pc";; esac
    if [ -n "$pc" ] && [ -x "$pc" ] && grep -q 'acp:pre-commit:check' "$pc" 2>/dev/null; then ok "pre-commit hook wired (the rules run on every commit, under any agent)"
    elif [ -n "$pc" ] && [ -f "$pc" ]; then meh "pre-commit hook is not the pipeline's; chain 'acp check --staged' into it to run the rules at commit time"
    elif [ "$profile" = minimal ]; then ok "no pre-commit hook (minimal profile)"
    else meh "no pre-commit hook; a closeout written by hand or a commit that skips the driver is caught by nothing — re-run install"; fi
    local pp; pp="$(cd "$target" && git rev-parse --git-path hooks/pre-push 2>/dev/null || true)"
    case "$pp" in ''|/*) ;; *) pp="$target/$pp";; esac
    if [ -n "$pp" ] && [ -x "$pp" ] && grep -q 'acp:pre-push:protect' "$pp" 2>/dev/null; then ok "pre-push hook wired (a force push or deletion of a shared branch is refused, under any agent)"
    elif [ -n "$pp" ] && [ -f "$pp" ]; then meh "pre-push hook is not the pipeline's; chain $proot/core/hooks/pre-push.sh into it, stdin included, to keep shared branches safe"
    elif [ "$profile" = minimal ]; then ok "no pre-push hook (minimal profile)"
    else meh "no pre-push hook; a force push that drops someone else's commits from a shared branch is caught by nothing — re-run install"; fi
    [ -f "$target/.github/workflows/acp-check.yml" ] && ok "CI runs the rules on pull requests" || meh "no CI workflow for the rules; 'acp ci github' adds one so nothing depends on the agent or the machine"
  else
    meh "not a git repository: the work-order gates hold, but nothing catches a closeout written by hand or a commit that skips the driver"
    meh "    a local repository costs nothing and turns that on:  (cd \"$target\" && git init) && $proot/bin/acp install \"$target\""
  fi
  if [ -f "$target/CLAUDE.md" ]; then
    grep -q '@AGENTS.md' "$target/CLAUDE.md" 2>/dev/null && ok "CLAUDE.md imports AGENTS.md" || meh "CLAUDE.md does not import AGENTS.md; Claude Code and other agents are reading different instructions"
  fi
  # Structure says nothing about whether the project's own tests pass. The
  # baseline is the first measurement, and everything recorded after it is
  # relative to it.
  local tdir bl; tdir="$(sed -n 's/^export TESTING_DIR="\([^"]*\)".*/\1/p' "$cfg" 2>/dev/null)"; tdir="${tdir:-Workspace/Testing}"; bl="$target/$tdir/results/BASELINE.md"
  if [ -f "$bl" ]; then
    local bfp cfp; bfp="$(grep -m1 -oE 'tree [0-9a-f]{16}' "$bl" | cut -d' ' -f2 || true)"; cfp="$(cd "$target" && "$dest/bin/wo" fingerprint 2>/dev/null || true)"
    if [ -n "$bfp" ] && [ "$bfp" = "$cfp" ]; then ok "baseline recorded against this exact tree: $(sed -n 's/^- \*\*Result:\*\* //p' "$bl" | head -1 | cut -c1-60)"
    else ok "baseline recorded ($(sed -n 's/^- \*\*Result:\*\* //p' "$bl" | head -1 | cut -c1-60)); the tree has changed since — re-run:  acp baseline"; fi
  else meh "no baseline: the project's own tests have never been run under this tool, so nothing recorded here is relative to a known state — run:  acp baseline"; fi
  # Installation is six work orders; operational means all six closed on evidence.
  if [ -d "$dest/core/templates/intake" ]; then
    local il; il="$(cd "$target" && "$dest/bin/acp" intake status 2>/dev/null | tail -1 || true)"
    case "$il" in
      operational*) ok "intake: $il";;
      "not yet operational"*) meh "intake: $il — run:  acp intake status";;
      *) meh "intake: no intake work orders yet — run:  acp intake";;
    esac
  fi
  local kbdir; kbdir="$(sed -n 's/^export KNOWLEDGE_DIR="\([^"]*\)".*/\1/p' "$cfg" 2>/dev/null)"; kbdir="${kbdir:-Workspace/Docs/KnowledgeBase}"
  if [ -f "$dest/core/hooks/kb.py" ]; then
    if [ -d "$target/$kbdir" ]; then
      local kl krc=0; kl="$(python3 "$dest/core/hooks/kb.py" status --root "$target" --kb "$target/$kbdir" 2>/dev/null | tail -1)" || krc=$?
      case "$krc" in 0) ok "knowledge base: $kl";; 1) meh "knowledge base: $kl — profiles describe code that changed; update them, then  acp kb bind";; 2) bad "knowledge base: $kl — profiles cite files or lines that no longer exist";; 4) meh "knowledge base: $kl — profiles short of the configured level; the intake work order for it says what to write";; *) meh "knowledge base: $kl";; esac
    else meh "no knowledge base: nothing describes this repository yet — the intake work order for it says how"; fi
  fi
  # The layout: work in the workspace, code in its folder, one pipeline, one knowledge base, and only the
  # tool wiring at the root. Detection only: moving things is acp migrate's job.
  if git -C "$target" rev-parse --show-toplevel >/dev/null 2>&1; then
    local le="$ROOT/core/hooks/layout.py" lo lrc=0 ll
    [ -f "$le" ] || [ ! -d "$ROOT/hooks/scripts" ] || le="$ROOT/hooks/scripts/layout.py"   # plugin layout
    lo="$(python3 "$le" --root "$target" 2>&1)" || lrc=$?
    case "$lrc" in
      0|1) # nothing out of place is said only when nothing was, warnings included
         case $'\n'"$lo" in *$'\n''warn '*) ;; *)
           [ "$lrc" -ne 0 ] || ok "layout: nothing out of place$(printf '%s\n' "$lo" | sed -n 's/^note: \(.*\)/ (\1)/p')";; esac
         while IFS= read -r ll; do case "$ll" in note:*|'') ;; "warn "*) meh "layout: ${ll#warn }";; *) bad "layout: $ll";; esac; done <<EOF_LAYOUT
$lo
EOF_LAYOUT
         ;;
      4) meh "layout: $(printf '%s\n' "$lo" | sed -n 's/^note: //p')";;
      *) bad "layout: not checked: $lo";;
    esac
  else meh "layout: not a git repository; not checked"; fi
  # Secret files: tested by name with git check-ignore; the owner's .gitignore is never written, the lines are printed.
  if git -C "$target" rev-parse --show-toplevel >/dev/null 2>&1; then
    local gaps; gaps="$(gi_gaps "$target")"
    if [ -z "$gaps" ]; then ok "secret files: the project's .gitignore keeps .env files, keys and certificates out of git"
    else
      meh "secret files: the project's .gitignore lets $(printf '%s\n' "$gaps" | cut -f1 | tr '\n' ' ')into git; add these lines to $target/.gitignore (acp doctor --gitignore-hint prints them alone):"
      gi_block "$target" | sed 's/^/          /'
    fi
  fi
  # Reporting "healthy" while the drivers cannot actually complete a lifecycle is
  # the worst failure a doctor can have: prove one end to end, here, now.
  if [ -x "$dest/bin/wo" ]; then
    # The probe runs in a scratch folder whose configuration sources the project's own and then pins PROJECT_ROOT
    # to that folder (a configuration that sources a sibling file still works), with a file in its code folder; never
    # in the project: closing a work order grows the knowledge base and writes the order's folder, and a doctor
    # writes nothing the project owns. If the scratch folder cannot be made, the probe is not run, and says so.
    local probe pn tmp code cfa
    tmpbase="${TMPDIR:-/tmp}"; if ! tmp="$(mktemp -d "${tmpbase%/}/acp-doctor.XXXXXX")"; then bad "lifecycle probe: not run: no scratch folder could be made"
    elif ! { cfa="$(cd "$(dirname "$cfg")" && pwd -P)/pipeline.config.sh" && printf '. %q\nexport PROJECT_ROOT=%q\n' "$cfa" "$tmp" > "$tmp/pipeline.config.sh"; }; then
      bad "lifecycle probe: not run: the configuration could not be written to $tmp"; rm -rf "$tmp"
    else
      # CODE_DIR as the drivers read it: the configuration sourced, so a later line wins
      code="$( . "$cfg" >/dev/null 2>&1; printf '%s' "${CODE_DIR:-.}" )" || code=.
      # Only a code folder wo would take (no absolute path, no leading -, no ..): the file never lands outside the
      # scratch folder; any other value is left for wo to refuse, and the probe reports it.
      case "$code" in .|/*|-*|..|../*|*/..|*/../*) ;; *) { mkdir -p "$tmp/$code" && printf 'probe\n' > "$tmp/$code/probe.txt"; } || true;; esac
      probe="$tmp/.acp-doctor-probe.sh"
      printf '#!/usr/bin/env bash\nexit 0\n' > "$probe" && chmod +x "$probe"
      # a wo new that fails prints no number: under pipefail a grep that finds none ended doctor with no word
      pn="$(cd "$tmp" && "$dest/bin/wo" new "acp doctor probe" --size trivial --area docs 2>/dev/null | { grep -o 'WO-[0-9]*' || true; } | head -1)" || pn=""
      if [ -n "$pn" ]; then
        pn="${pn#WO-}"
        # The probe's verification document is untouched template, so the placeholder
        # gate would refuse the close. That gate is for human work, not for this.
        if ( cd "$tmp" && "$dest/bin/wo" verify "$pn" --run "$probe" >/dev/null 2>&1 \
               && ALLOW_PLACEHOLDERS=1 "$dest/bin/wo" close "$pn" >/dev/null 2>&1 ); then
          ok "lifecycle probe: a work order opened, verified and closed in this layout (in a scratch copy)"
        else bad "lifecycle probe failed: the drivers cannot complete a work order in this layout"; fi
      else bad "lifecycle probe: wo new failed in this layout"; fi
      rm -rf "$tmp"
    fi
  fi
  echo
  if [ "$fail" -gt 0 ]; then echo "$fail failure(s), $warn warning(s)"; return 1; fi
  echo "healthy — $warn warning(s)"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  init)          exec "$BIN/new-project" "$@";;
  install)       exec "$BIN/install.sh" "$@";;
  doctor)        if [ "${1:-}" = --gitignore-hint ]; then gitignore_hint "${2:-}"; else doctor "${1:-}"; fi;;
  wo)            exec "$BIN/wo" "$@";;
  check)
    # One implementation of the rules, callable from anywhere: wo close, a git
    # pre-commit hook, CI, or by hand. Works with or without git.
    root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
    ex=()
    if [ -f "$root/pipeline.config.sh" ]; then
      for k in WORKORDERS_DIR BUGS_DIR SESSIONS_DIR KNOWLEDGE_DIR; do v="$(sed -n "s/^export $k=\"\([^\"]*\)\".*/\1/p" "$root/pipeline.config.sh" | head -1)"; [ -n "$v" ] && ex+=("$v"); done
    fi
    ex+=("${ROOT#$root/}")
    exec python3 "$ROOT/core/hooks/check.py" --root "$root" --exclude "${ex[@]}" "$@";;
  publish-check)
    # Before any first push. A push publishes every commit on every branch, so the whole history is
    # read with bin/sanitize's rules, with the files a commit could still add. It reports; it never
    # writes, rewrites history, fetches or pushes.
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "acp publish-check: not inside a git repository" >&2; exit 3; }
    # this pipeline's own place: the repository itself, a folder inside it, or outside it (kept absolute)
    case "$ROOT" in "$root") pd=.;; "$root"/*) pd="${ROOT#"$root"/}";; *) pd="$ROOT";; esac
    [ -f "$ROOT/core/hooks/publish-check.py" ] || { echo "acp publish-check: engine missing ($ROOT/core/hooks/publish-check.py)" >&2; exit 3; }
    exec python3 "$ROOT/core/hooks/publish-check.py" --root "$root" --sanitize "$BIN/sanitize" --pipeline-dir "$pd" "$@";;
  intake)
    # Installation is work, and work here is a work order. Six of them, each with a
    # shipped spec and a shipped suite, and the project is operational when every
    # one has closed on an executed pass. Idempotent: an existing step is kept.
    root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
    cfg="$root/pipeline.config.sh"; [ -f "$cfg" ] || { echo "acp intake: no pipeline.config.sh at $root; install first" >&2; exit 1; }
    wod="$(sed -n 's/^export WORKORDERS_DIR="\([^"]*\)".*/\1/p' "$cfg" | head -1)"; wod="${wod:-Workspace/Docs/WorkOrders}"
    bugd="$(sed -n 's/^export BUGS_DIR="\([^"]*\)".*/\1/p' "$cfg" | head -1)"; bugd="${bugd:-Workspace/Docs/Bugs}"
    tdir="$(sed -n 's/^export TESTING_DIR="\([^"]*\)".*/\1/p' "$cfg" | head -1)"; tdir="${tdir:-Workspace/Testing}"
    rel="${ROOT#"$root"/}"; T="$ROOT/core/templates/intake"   # the root quoted: a literal, not a pattern
    intake_state() { # step -> closed | verified | open | missing, and the number
      local st="" num="" dd
      for dd in "$root/$wod"/WO-*; do
        [ -f "$dd/.wo-meta" ] && [ "$(sed -n 's/^intake=//p' "$dd/.wo-meta" | head -1)" = "$1" ] || continue
        num="$(basename "$dd")"; num="${num#WO-}"; num="${num%%-*}"
        if ls "$dd" | grep -qi "WO-$num-CLOSEOUT"; then st=closed
        else
          # The document's own status line decides, as wo close reads it: an older passing run in
          # its history, or a passing copy beside it, does not.
          local ln; ln="$(grep -m1 -E '^\*\*Overall status:\*\*' "$dd/WO-$num-VERIFICATION.md" 2>/dev/null || true)"
          ln="${ln#\*\*Overall status:\*\*}"; ln="${ln# }"; st=open
          case "$ln" in "EXECUTED — PASS"*|"EXECUTED – PASS"*|"EXECUTED - PASS"*) st=verified;; esac
        fi
        break
      done
      printf '%s %s\n' "${st:-missing}" "$num"
    }
    case "${1:-}" in
      status)
        [ -d "$T" ] || { echo "acp intake: no intake templates shipped with this pipeline" >&2; exit 1; }
        closed=0; total=0
        printf '  %-4s %-8s %-10s %s\n' "STEP" "WO" "STATE" "TITLE"
        for spec in "$T"/INTAKE-0*.md; do
          [ -f "$spec" ] || continue; total=$((total+1))
          step="$(basename "$spec" .md)"; n="${step#INTAKE-}"; n="${n%%-*}"; title="$(grep -m1 '^# ' "$spec" | sed 's/^# *WO-XXXX: *//; s/^# *//')"
          set -- $(intake_state "$n"); st="$1"; num="${2:-}"
          [ "$st" = closed ] && closed=$((closed+1))
          printf '  %-4s %-8s %-10s %s\n' "$n" "${num:+WO-$num}" "$st" "$title"
        done
        echo; [ "$closed" -eq "$total" ] && echo "operational: every intake step has closed on executed evidence" || echo "not yet operational: $closed of $total intake steps closed with evidence"
        [ "$closed" -eq "$total" ];;
      inventory)
        py="$ROOT/core/hooks/inventory.py"; [ -f "$py" ] || { echo "acp intake: inventory engine missing" >&2; exit 1; }
        kbd="$(sed -n 's/^export KNOWLEDGE_DIR="\([^"]*\)".*/\1/p' "$cfg" | head -1)"; kbd="${kbd:-Workspace/Docs/KnowledgeBase}"
        # The inventory is part of the repository's description, so it lives with
        # the knowledge base, outside the evidence fingerprint.
        out="$root/$kbd/INDEX.md"; mkdir -p "$(dirname "$out")"
        python3 "$py" --root "$root" --workorders-dir "$wod" --bugs-dir "$bugd" --testing-dir "$tdir" --pipeline-dir "$rel" --knowledge-dir "$kbd" --out "$out" >/dev/null && echo "wrote ${out#$root/}: what this repository is, the shape of its record, and how to bring it in" || exit 1;;
      "")
        [ -d "$T" ] || { echo "acp intake: no intake templates shipped with this pipeline" >&2; exit 1; }
        W="$ROOT/bin/wo"; opened=0; kept=0
        for spec in "$T"/INTAKE-0*.md; do
          [ -f "$spec" ] || continue
          step="$(basename "$spec" .md)"; n="${step#INTAKE-}"; n="${n%%-*}"; slug="${step#INTAKE-0?-}"
          # the step's spec and suite are read before its order is opened: perl only warns "Can't open" and exits 0
          for t in "$spec" "$T/intake-$n-$slug.sh"; do
            [ "$t" != "$spec" ] && [ ! -e "$t" ] && continue   # a step without a suite has none to read
            [ -f "$t" ] && [ -r "$t" ] || { echo "acp intake: template missing or unreadable: $t" >&2; exit 1; }
          done
          title="$(grep -m1 '^# ' "$spec" | sed 's/^# *WO-XXXX: *//; s/^# *//')"
          set -- $(intake_state "$n"); [ "$1" != missing ] && { kept=$((kept+1)); continue; }
          case "$slug" in knowledge-base) area=analysis;; baseline|suites) area=testing;; *) area=docs;; esac
          # wo new's own refusal (a template it cannot read, say) reaches the person; under pipefail a failing
          # wo new in a pipe ended intake with no word at all
          made="$(cd "$root" && "$W" new "$title" --size small --area "$area")" || { echo "acp intake: could not open step $n" >&2; exit 1; }
          num="$(printf '%s\n' "$made" | { grep -o 'WO-[0-9]*' || true; } | head -1)"; num="${num#WO-}"
          [ -n "$num" ] || { echo "acp intake: could not open step $n" >&2; continue; }
          dd="$(find "$root/$wod" -maxdepth 1 -type d -name "WO-$num-*" | head -1)"
          # the shipped spec replaces the template: complete prose, nothing to fill in
          spec_out="$dd/WO-$num-SPEC.md"
          # the number and the path go in as data, in one pass: a | or & in the path broke sed's program
          { ACP_T_NUM="$num" ACP_T_PR="$rel" perl -C0 -pe 'BEGIN { %v = ("WO-XXXX" => "WO-$ENV{ACP_T_NUM}", "{{PIPELINE_ROOT}}" => $ENV{ACP_T_PR}) } s/(WO-XXXX|\{\{PIPELINE_ROOT\}\})/$v{$1}/g' "$spec"
            [ -f "$spec_out" ] && awk '/^## Specialists for this work order/{p=1} p' "$spec_out" | sed '1s/^/\n---\n\n/'
          } > "$spec_out.new" && mv "$spec_out.new" "$spec_out"
          printf 'intake=%s\n' "$n" >> "$dd/.wo-meta"
          suite_src="$T/intake-$n-$slug.sh"; suite_dst="$root/$tdir/suites/intake-$n-$slug.sh"
          if [ -f "$suite_src" ]; then mkdir -p "$(dirname "$suite_dst")"; ACP_T_PR="$rel" perl -C0 -pe 's/\{\{PIPELINE_ROOT\}\}/$ENV{ACP_T_PR}/g' "$suite_src" > "$suite_dst"; chmod +x "$suite_dst"; fi   # the path goes in as data: a | or & in it is text
          opened=$((opened+1))
          printf '  WO-%s  %s\n' "$num" "$title"
        done
        # The knowledge base is scaffolded here, by the tool, so the step that asks for
        # it can pass on day one at the lite level. Raising the level is agent work.
        # An upgrade (install says so) never writes the project's knowledge base: it says how to scaffold by hand.
        if [ "${ACP_INSTALL_UPGRADE:-0}" = 1 ]; then
          echo "  knowledge base: not touched: an upgrade leaves the project's knowledge base as it is. To create or extend it:  acp kb scaffold"
        elif [ -f "$ROOT/core/hooks/kb.py" ] && python3 "$ROOT/core/hooks/kb.py" scaffold --help >/dev/null 2>&1; then
          kbd2="$(sed -n 's/^export KNOWLEDGE_DIR="\([^"]*\)".*/\1/p' "$cfg" | head -1)"; kbd2="${kbd2:-Workspace/Docs/KnowledgeBase}"
          lvl2="$(sed -n 's/^export KNOWLEDGE_LEVEL="\([^"]*\)".*/\1/p' "$cfg" | head -1)"; lvl2="${lvl2:-lite}"
          # Every line the scaffold prints is shown, then every knowledge-base file it added or rewrote, so an
          # install never changes a document the person cannot see named.
          kb_snap() { ( cd "$1" 2>/dev/null || exit 0; find . -type f 2>/dev/null | LC_ALL=C sort | while IFS= read -r f; do printf '%s\t%s\n' "${f#./}" "$(cksum 2>/dev/null < "$f")"; done ) || true; }
          kb_before="$(kb_snap "$root/$kbd2")" || kb_before=""
          ( cd "$root" && python3 -u "$ROOT/core/hooks/kb.py" scaffold --root "$root" --kb "$root/$kbd2" --level "$lvl2" --pipeline-dir "$rel" 2>&1 | sed 's/^/  knowledge base: /' ) || true
          awk -F '\t' 'NR == FNR { if ($0 != "") b[$1] = $2; next } $0 == "" { next } !($1 in b) { print "  knowledge base: added " $1; next } b[$1] != $2 { print "  knowledge base: rewrote " $1 }' <(printf '%s\n' "$kb_before") <(kb_snap "$root/$kbd2") || true
        fi
        echo "intake: $opened step(s) opened, $kept already present. Each has a shipped suite under $tdir/suites/;"
        echo "        verify a step with  wo verify <n> --run $tdir/suites/intake-0N-<step>.sh   and close it. Then:  acp intake status";;
      *) echo "usage: acp intake [status|inventory]" >&2; exit 1;;
    esac;;
  layout)
    # The one writer of the two-folder layout's settings: the code folder and the pipeline folder side by side in
    # one repository. It rewrites only the location lines of ./pipeline.config.sh, as data, and refuses a config
    # it cannot read with certainty rather than guess; --check runs the same checks on the config and writes
    # nothing, so a caller can know before it moves anything. new-project and the migration call it; install checks.
    pdir="" cdir="" lcheck=""
    lusage() { echo "usage: acp layout [--check] --pipeline-dir <folder> --code-dir <folder>" >&2; exit 1; }
    while [ $# -gt 0 ]; do
      case "$1" in
        --pipeline-dir|--code-dir) [ $# -ge 2 ] && [ -n "$2" ] && [ "${2#-}" = "$2" ] || lusage
                                   if [ "$1" = --pipeline-dir ]; then pdir="$2"; else cdir="$2"; fi; shift 2;;
        --check) lcheck=1; shift;;
        *) lusage;;
      esac
    done
    [ -n "$pdir" ] && [ -n "$cdir" ] || lusage
    for v in "$pdir" "$cdir"; do
      case "$v" in *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-]*|.*|-*) printf 'acp layout: --pipeline-dir and --code-dir each take one folder name (letters, digits, ".", "_", "-"; not starting with "." or "-"), got: %q\n' "$v" >&2; exit 1;; esac
      case "$(printf '%s' "$v" | LC_ALL=C tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')" in
        workspace|pipeline.config.sh|agents.md|claude.md) printf 'acp layout: %q is a name the layout or the tools use at the top of the repository (in any case); choose another\n' "$v" >&2; exit 1;;
      esac
    done
    [ "$(printf '%s' "$pdir" | LC_ALL=C tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')" != "$(printf '%s' "$cdir" | LC_ALL=C tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')" ] \
      || { echo "acp layout: the pipeline folder and the code folder must differ, also ignoring case" >&2; exit 1; }
    { [ -f pipeline.config.sh ] && [ ! -L pipeline.config.sh ]; } || { echo "acp layout: no pipeline.config.sh in this folder (run it in the repository root; a link is refused)" >&2; exit 1; }
    if [ -z "$lcheck" ]; then   # the writer changes nothing while the project is still laid out the old way
      for x in .aicodepipeline Workspace; do
        { [ ! -e "$x" ] && [ ! -L "$x" ]; } || { echo "acp layout: $x is still at the top of the repository; move the project with  acp migrate  (plan, backup, then apply) first (pipeline.config.sh is unchanged)" >&2; exit 1; }
      done
      { [ -d "$cdir" ] && [ ! -L "$cdir" ]; } || { echo "acp layout: $cdir/ is not a folder in the repository (a link is refused); move the project with  acp migrate  (plan, backup, then apply) first, or make it (pipeline.config.sh is unchanged)" >&2; exit 1; }
    fi
    ACP_P="$pdir" ACP_C="$cdir" ACP_CHECK="$lcheck" python3 -I - pipeline.config.sh <<'PYEOF'
import os, re, sys, tempfile
path = sys.argv[1]; p, c = os.environ["ACP_P"], os.environ["ACP_C"]
want = [("PIPELINE_ROOT", p + "/.aicodepipeline"), ("WORKSPACE_DIR", p + "/Workspace"), ("DOCS_DIR", p + "/Workspace/Docs"),
        ("WORKORDERS_DIR", p + "/Workspace/Docs/WorkOrders"), ("BUGS_DIR", p + "/Workspace/Docs/Bugs"),
        ("TESTING_DIR", p + "/Workspace/Testing"), ("KNOWLEDGE_DIR", p + "/Workspace/Docs/KnowledgeBase"),
        ("SESSIONS_DIR", p + "/Workspace/Sessions"), ("CODE_DIR", c), ("PLAYBOOKS_DIR", p + "/playbooks")]
optional = {"CODE_DIR": "SESSIONS_DIR", "PLAYBOOKS_DIR": "CODE_DIR"}   # added after this line when absent (older configs)
root_line = 'export PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"'
def refuse(msg):
    print("acp layout: " + msg + "; pipeline.config.sh is unchanged", file=sys.stderr); sys.exit(1)
try:
    with open(path, encoding="utf-8", newline="") as f: text = f.read()
except (OSError, UnicodeDecodeError) as e:
    refuse("cannot read pipeline.config.sh as UTF-8 text (%s)" % e.__class__.__name__)
if "\r" in text:
    refuse("pipeline.config.sh holds a carriage return (CRLF line ends); save it with plain line ends")
lines = text.split("\n")
for l in lines:   # a line that runs another file could set anything; a config read with certainty runs none
    if re.match(r"^\s*(\.|source|eval)(\s|$)", l):
        refuse("pipeline.config.sh runs other code (%r); the layout is set only in a config that does not" % l.strip()[:60])
plain = re.compile(r'^export ([A-Z_]+)="([^"$`\\]*)"(\s+#.*)?$')
code = [l for l in lines if not l.lstrip().startswith("#")]   # a whole-line comment is never a definition
for n in [n for n, _ in want] + ["PROJECT_ROOT"]:
    uses = [l for l in code if re.search(r"(^|[^A-Za-z0-9_])%s([^A-Za-z0-9_]|$)" % n, l)]
    if n == "PROJECT_ROOT":
        if len(uses) != 1 or not re.match(r"^%s(\s+#.*)?$" % re.escape(root_line), uses[0]):
            old = 'export PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"'
            hint = " (a config from before 1.2 says pwd: change it to pwd -P)" if any(l.startswith(old) for l in uses) else ""
            refuse("PROJECT_ROOT must be set once, as this file's own folder, and used nowhere else: " + root_line + hint)
        continue
    if not uses and n in optional:
        continue
    if not uses and n == "KNOWLEDGE_DIR":
        refuse('KNOWLEDGE_DIR is not set (a config from before 1.3): add  export KNOWLEDGE_DIR="Workspace/Docs/KnowledgeBase"  after TESTING_DIR, then run this again')
    if len(uses) != 1 or not plain.match(uses[0]):
        refuse("%s must be set exactly once, as export %s=\"<value>\" with no $, backtick, quote or backslash, and used nowhere else" % (n, n))
out, changed = list(lines), []
for n, v in want:
    idx = [i for i, l in enumerate(out) if l.startswith("export %s=" % n)]
    if not idx:
        j = [i for i, l in enumerate(out) if l.startswith("export %s=" % optional[n])][0]
        out.insert(j + 1, 'export %s="%s"' % (n, v)); changed.append("%s=%s (added)" % (n, v)); continue
    m = plain.match(out[idx[0]])
    if m.group(2) != v:
        out[idx[0]] = 'export %s="%s"%s' % (n, v, m.group(3) or ""); changed.append("%s=%s (was %s)" % (n, v, m.group(2)))
if changed and os.environ.get("ACP_CHECK"):
    print("acp layout: pipeline.config.sh can be set for the %s/ + %s/ layout (nothing written):" % (p, c))
    for x in changed: print("  " + x)
elif changed:
    fd, tmp = tempfile.mkstemp(dir=".", prefix=".pipeline.config.")   # created exclusively, never through a link
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as f: f.write("\n".join(out))
        os.chmod(tmp, os.stat(path).st_mode & 0o7777); os.replace(tmp, path)
    except OSError:
        os.unlink(tmp); refuse("could not write the new pipeline.config.sh")
    print("acp layout: pipeline.config.sh now names the %s/ + %s/ layout:" % (p, c))
    for x in changed: print("  " + x)
else:
    print("acp layout: pipeline.config.sh already names the %s/ + %s/ layout" % (p, c))
PYEOF
    ;;
  kb)
    root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
    kbd="Workspace/Docs/KnowledgeBase"
    [ -f "$root/pipeline.config.sh" ] && { v="$(sed -n 's/^export KNOWLEDGE_DIR="\([^"]*\)".*/\1/p' "$root/pipeline.config.sh" | head -1)"; [ -n "$v" ] && kbd="$v"; }
    py="$ROOT/core/hooks/kb.py"; [ -f "$py" ] || { echo "acp kb: engine missing ($py)" >&2; exit 1; }
    sub="${1:-status}"; shift || true
    case "$sub" in
      status|bind|impact) exec python3 "$py" "$sub" --root "$root" --kb "$root/$kbd" "$@";;
      scaffold)
        lvl="lite"; [ -f "$root/pipeline.config.sh" ] && { v="$(sed -n 's/^export KNOWLEDGE_LEVEL="\([^"]*\)".*/\1/p' "$root/pipeline.config.sh" | head -1)"; [ -n "$v" ] && lvl="$v"; }
        exec python3 "$py" scaffold --root "$root" --kb "$root/$kbd" --level "$lvl" --pipeline-dir "${ROOT#$root/}" --legacy-rebuild "$@";;
      *) echo "usage: acp kb status|bind|impact|scaffold" >&2; exit 1;;
    esac;;
  migrate)
    # The move into app/ and acp/. plan reads the project and writes only .acp-migration/.
    py="$ROOT/core/hooks/migrate.py"; [ -f "$py" ] || { echo "acp migrate: engine missing ($py)" >&2; exit 1; }
    case "${1:-}" in
      plan|backup|answer|apply|rollback) exec python3 -I "$py" "$@";;
      *) printf 'usage: acp migrate plan [--project <dir>] [--repo <dir>] [--replace]\n       acp migrate backup --to <dir> [--project <dir>] [--repo <dir>] | --check [--project <dir>] [--repo <dir>]\n       acp migrate answer <n> <option> | <n> --folder <dir> [--project <dir>]\n       acp migrate apply [--project <dir>] [--repo <dir>]\n       acp migrate rollback [--project <dir>] [--archive <file>] [--accept-repository-changes] [--keep-changes] [--after-interrupted-apply]\n' >&2; exit 1;;
    esac;;
  baseline)
    # The first measurement of a project the tool is about to record evidence
    # about. Structure checks pass on a codebase whose tests have been dead for a
    # month; this is the step that asks.
    root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
    cfg="$root/pipeline.config.sh"; tdir="Workspace/Testing"; bcmd=""; wod="Workspace/Docs/WorkOrders"
    if [ -f "$cfg" ]; then
      v="$(sed -n 's/^export TESTING_DIR="\([^"]*\)".*/\1/p' "$cfg" | head -1)"; [ -n "$v" ] && tdir="$v"
      v="$(sed -n 's/^export WORKORDERS_DIR="\([^"]*\)".*/\1/p' "$cfg" | head -1)"; [ -n "$v" ] && wod="$v"
      v="$(sed -n 's/^export BASELINE_COMMAND="\([^"]*\)".*/\1/p' "$cfg" | head -1)"; [ -n "$v" ] && bcmd="$v"
    fi
    dry=0; while [ $# -gt 0 ]; do case "$1" in --command) bcmd="$2"; shift 2;; --dry-run) dry=1; shift;; *) echo "usage: acp baseline [--command '<test command>'] [--dry-run]" >&2; exit 1;; esac; done
    echo "== baseline for $root"
    # 1. a source state that can be returned to
    if ! git -C "$root" rev-parse --show-toplevel >/dev/null 2>&1; then
      echo "  no git repository. A baseline is a measurement of a source state, and without one"
      echo "  there is nothing to return to. Create it first:  (cd \"$root\" && git init && git add -A && git commit -m baseline)"; exit 1
    fi
    if ! git -C "$root" rev-parse HEAD >/dev/null 2>&1; then
      echo "  the repository has no commits. Commit the tree as it stands, then run this again:"
      echo "      (cd \"$root\" && git add -A && git commit -m baseline)"; exit 1
    fi
    sha="$(git -C "$root" rev-parse --short HEAD)"; dirty="$(git -C "$root" status --porcelain | wc -l | tr -d ' ')"
    echo "  source: $sha with $dirty uncommitted path(s)"
    if git -C "$root" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
      ab="$(git -C "$root" rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null || echo '? ?')"; up="$(git -C "$root" rev-parse --abbrev-ref '@{upstream}')"
      echo "  remote: behind ${ab%% *}, ahead ${ab##* } of $up"
      [ "${ab%% *}" != 0 ] && echo "          the pushed tree is not this tree; decide which one is the project of record before trusting this baseline"
    else echo "  remote: none tracked — nothing says whether this directory is the project of record"; fi
    # 2. what the project already runs
    if [ -z "$bcmd" ] && [ -x "$ROOT/bin/detect-stack" ]; then
      bcmd="$("$ROOT/bin/detect-stack" "$root" --json 2>/dev/null | python3 -c 'import json,sys; print((json.load(sys.stdin).get("commands") or {}).get("test",""))' 2>/dev/null || true)"
    fi
    [ -n "$bcmd" ] || { echo "  no test command found. Give one:  acp baseline --command 'npm test'   (or set BASELINE_COMMAND in pipeline.config.sh)"; exit 1; }
    echo "  command: $bcmd"
    fp="$(cd "$root" && "$ROOT/bin/wo" fingerprint 2>/dev/null || echo nofp)"
    [ "$dry" -eq 1 ] && { echo "  (dry run: nothing executed; would record against tree $fp)"; exit 0; }
    # 3. run it, and record the result as the first measurement
    mkdir -p "$root/$tdir/results"; blog="$root/$tdir/results/BASELINE.log"; bl="$root/$tdir/results/BASELINE.md"
    echo "  running…"; brc=0; ( cd "$root" && bash -c "$bcmd" ) > "$blog" 2>&1 || brc=$?
    counts="$("$ROOT/bin/wo" counts "$blog" 2>/dev/null || true)"
    case "$brc" in 0) res="PASS";; 77) res="COULD NOT RUN (exit 77)";; *) res="FAIL (exit $brc)";; esac
    [ -n "$counts" ] && res="$res, ${counts% *} passed, ${counts#* } failed"
    # 4. the record versus the measurement
    total=0; adopted=0; verified=0; nover=0
    for d in "$root/$wod"/WO-*; do
      [ -d "$d" ] || continue; total=$((total+1))
      grep -q '^adopted=' "$d/.wo-meta" 2>/dev/null && adopted=$((adopted+1))
      if ls "$d" | grep -qi VERIFICATION; then
        # the work order's own document, and its status line alone, as wo close reads it
        ln="$(grep -m1 -E '^\*\*Overall status:\*\*' "$d/$(basename "$d" | cut -d- -f1-2)-VERIFICATION.md" 2>/dev/null || true)"
        ln="${ln#\*\*Overall status:\*\*}"; ln="${ln# }"
        case "$ln" in "EXECUTED — PASS"*|"EXECUTED – PASS"*|"EXECUTED - PASS"*) verified=$((verified+1));; esac
      else nover=$((nover+1)); fi
    done
    {
      printf '# Baseline\n\nThe first measurement of this project under the pipeline. Everything recorded after it is relative to this.\n\n'
      printf -- '- **Taken:** %s\n- **Source:** %s, %s uncommitted path(s), tree %s\n- **Command:** `%s`\n- **Result:** %s\n- **Log:** `%s`\n\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$sha" "$dirty" "$fp" "$bcmd" "$res" "$(basename "$blog")"
      printf '## The record against the measurement\n\n'
      printf -- '- work orders on file: %s (%s adopted from an earlier record)\n- with an executed pass under this tool: %s\n- with no verification at all: %s\n\n' "$total" "$adopted" "$verified" "$nover"
      printf 'A recorded completion is a claim. Only the ones with an executed pass above are measured; the rest are recorded, not verified.\n\n'
      printf '```\n'; tail -40 "$blog"; printf '```\n'
    } > "$bl"
    echo "  result: $res"
    echo "  record: $total work orders, $adopted adopted, $verified with an executed pass, $nover with no verification"
    echo "  written: ${bl#$root/}"
    [ "$brc" -eq 0 ] || { echo "  a failing baseline is information, not a block: it is the state the project is actually in"; exit 1; };;
  ci)
    case "${1:-}" in
      github)
        root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
        dest="$root/.github/workflows/acp-check.yml"
        [ -f "$dest" ] && { echo "acp: $dest exists — left alone"; exit 0; }
        rel="${ROOT#"$root"/}"
        # The path is written unquoted into the workflow's shell: anything but plain path characters
        # there would be split or run, so it is refused before anything is written.
        case "$rel" in ""|*[!A-Za-z0-9._/@+-]*) echo "acp: the pipeline's path '$rel' holds characters the workflow would split or run; move it under a plain path" >&2; exit 1;; esac
        t="$ROOT/core/templates/ci/acp-check.yml"   # refused before anything is written: perl exits 0 on a missing file
        [ -f "$t" ] && [ -r "$t" ] || { echo "acp: template missing or unreadable: $t" >&2; exit 1; }
        mkdir -p "$(dirname "$dest")"
        ACP_T_PR="$rel" perl -C0 -pe 's/\{\{PIPELINE_ROOT\}\}/$ENV{ACP_T_PR}/g' "$ROOT/core/templates/ci/acp-check.yml" > "$dest"
        echo "wrote ${dest#$root/}: the rules run on every pull request, whoever made the commits";;
      *) echo "usage: acp ci github" >&2; exit 1;;
    esac;;
  command|commands|skill|skills)
    # Slash commands and skills are Claude Code features; their content is text
    # any agent can read and follow. This is how every other agent reaches it.
    root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
    case "$cmd" in
      commands) for f in "$ROOT"/core/commands/*.md; do [ -f "$f" ] || continue; printf '  %-26s %s\n' "$(basename "$f" .md)" "$(sed -n 's/^description: *//p' "$f" | head -1 | cut -c1-90)"; done;;
      skills)   for d in "$ROOT"/core/skills/*/ "$ROOT"/core/skill-sets/*/*/; do [ -f "$d/SKILL.md" ] || continue; printf '  %-34s %s\n' "$(basename "$d")" "$(sed -n 's/^description: *//p' "$d/SKILL.md" | head -1 | cut -c1-80)"; done;;
      command)  n="${1:-}"; [ -n "$n" ] || { echo "usage: acp command <name>   (acp commands lists them)" >&2; exit 1; }
                f="$ROOT/core/commands/$n.md"; [ -f "$f" ] || { echo "acp: no command named '$n'" >&2; exit 1; }
                [ -r "$f" ] || { echo "acp: template missing or unreadable: $f" >&2; exit 1; }   # refused before anything is printed: perl exits 0 on a file it cannot read
                echo "# /$n — read this as your instructions; where it says to load a skill, run:  acp skill <name>"; echo
                ACP_T_PR="${ROOT#"$root"/}" perl -C0 -pe 's/\{\{PIPELINE_ROOT\}\}/$ENV{ACP_T_PR}/g' "$f";;   # as data
      skill)    n="${1:-}"; [ -n "$n" ] || { echo "usage: acp skill <name>   (acp skills lists them)" >&2; exit 1; }
                for c in "$ROOT/core/skills/$n/SKILL.md" "$ROOT"/core/skill-sets/*/"$n"/SKILL.md "$root/.claude/skills/$n/SKILL.md"; do [ -f "$c" ] && { [ -r "$c" ] || { echo "acp: template missing or unreadable: $c" >&2; exit 1; }; ACP_T_PR="${ROOT#"$root"/}" perl -C0 -pe 's/\{\{PIPELINE_ROOT\}\}/$ENV{ACP_T_PR}/g' "$c"; exit 0; }; done   # the path goes in as data
                echo "acp: no skill named '$n'" >&2; exit 1;;
    esac;;
  agent)
    n="${1:-}"; [ -n "$n" ] || { echo "usage: acp agent <name>   (acp agents lists them)" >&2; exit 1; }
    root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
    for c in "$root/.claude/agents/$n.md" "$ROOT/core/agents/base/$n.md" "$ROOT/core/agents/roles/$n.md" "$ROOT/core/agents/sets/$n.md" "$ROOT/agents/$n.md"; do
      [ -f "$c" ] && exec cat "$c"
    done
    echo "acp: no specialist named '$n'" >&2; exit 1;;
  agents)
    if [ "${1:-}" = "--area" ] && [ -n "${2:-}" ]; then
      exec "$BIN/wo" route "$2"
    fi
    for d in "$ROOT/core/agents/base" "$ROOT/core/agents/roles" "$ROOT/core/agents/sets" "$ROOT/agents"; do
      [ -d "$d" ] || continue
      for f in "$d"/*.md; do [ -f "$f" ] || continue; printf '  %-34s %s\n' "$(basename "$f" .md)" "$(sed -n 's/^description: *//p' "$f" | head -1 | cut -c1-90)"; done
    done;;
  bug)           exec "$BIN/bug" "$@";;
  playbook)      exec "$BIN/playbook" "$@";;
  pack)          exec "$BIN/pack" "$@";;   # old name; bin/pack says so and forwards
  sanitize)      exec "$BIN/sanitize" "$@";;
  detect-stack)  exec "$BIN/detect-stack" "$@";;
  eval)          exec "$BIN/eval" "$@";;
  test)
    live=0; for a in "$@"; do [ "$a" = "--live" ] && live=1; done
    rc=0
    echo "== lint";      "$BIN/lint" | tail -1 || rc=1; "$BIN/lint" >/dev/null 2>&1 || rc=1
    # An installed copy ships a subset of these directories, and sanitize reserves
    # exit 3 for its own usage errors: neither is a critical finding.
    echo "== sanitize"
    for d in core bin docs harness playbooks; do
      [ -d "$ROOT/$d" ] || continue
      r=0; "$BIN/sanitize" "$ROOT/$d" --quiet >/dev/null 2>&1 || r=$?
      case "$r" in
        0|1) echo "  $d clean";;
        2)   echo "  $d FAIL (critical findings)"; rc=1;;
        *)   echo "  $d FAIL (sanitize could not scan it, exit $r)"; rc=1;;
      esac
    done
    if [ -f "$ROOT/pipeline.config.example.sh" ]; then echo "== evaluations (pipeline repository: full suite)"
    else echo "== evaluations (installed copy: the ones needing source fixtures are skipped)"; fi
    tmpbase="${TMPDIR:-/tmp}"; elog="$(mktemp "${tmpbase%/}/acp-test-eval.XXXXXX")"
    er=0; "$BIN/eval" run 2>&1 | tee "$elog" || er=$?
    [ "$er" -eq 0 ] || rc=1
    existing=0; for f in "$ROOT"/harness/evals/*/eval.sh; do [ -f "$f" ] && existing=$((existing+1)); done
    may_skip=0
    if [ ! -f "$ROOT/pipeline.config.example.sh" ]; then
      for f in "$ROOT"/harness/evals/*/.source-only; do [ -f "$f" ] && may_skip=$((may_skip+1)); done
    fi
    sline="$(grep '^eval-summary: ' "$elog" | tail -1 || true)"; rm -f "$elog"
    if [ "$existing" -eq 0 ]; then echo "  evaluations FAIL: no evaluations found under harness/evals"; rc=1
    elif [ -z "$sline" ]; then echo "  evaluations FAIL: eval run printed no summary line"; rc=1
    else
      sp="$(printf '%s\n' "$sline" | sed -n 's/.*passed=\([0-9][0-9]*\).*/\1/p')"
      sf="$(printf '%s\n' "$sline" | sed -n 's/.*failed=\([0-9][0-9]*\).*/\1/p')"
      ss="$(printf '%s\n' "$sline" | sed -n 's/.*skipped=\([0-9][0-9]*\).*/\1/p')"
      if [ -z "$sp" ] || [ -z "$sf" ] || [ -z "$ss" ]; then echo "  evaluations FAIL: eval run printed no summary line"; rc=1
      elif [ $((sp + sf + ss)) -ne "$existing" ] || [ "$ss" -ne "$may_skip" ]; then
        echo "  evaluations FAIL: $((sp + sf)) ran and $ss skipped, but $existing exist ($may_skip may be skipped here)"; rc=1
      else echo "  evaluations: $((sp + sf)) of $existing ran ($ss skipped by design)"
        if [ "$sf" -gt 0 ] && [ "$er" -eq 0 ]; then echo "  evaluations FAIL: eval run reported $sf failed but exited 0"; rc=1; fi
      fi
    fi
    # Assembling the plugin is something only the pipeline repository can do; an
    # installed copy has no inputs for it, and failing it there would be noise.
    if [ -f "$ROOT/pipeline.config.example.sh" ]; then
      echo "== plugin"
      # bound_seconds prints its complaint first and the effective value last
      bs="$(bound_seconds "${ACP_PLUGIN_TIMEOUT:-120}" ACP_PLUGIN_TIMEOUT)"
      echo "$bs" | sed '$d' | grep . || true
      local_to="$(echo "$bs" | tail -1)"
      r=0; run_bounded "$local_to" "$BIN/build-plugin" || r=$?
      case "$r" in
        0)   echo "  built dist/plugin";;
        124) echo "  build-plugin timed out after ${local_to}s"; rc=1;;
        *)   echo "  build-plugin FAILED"; rc=1;;
      esac
      if [ "$r" -eq 0 ]; then
        if [ "${ACP_SKIP_PLUGIN_VALIDATE:-0}" = 1 ]; then echo "  (plugin validation skipped by request)"
        elif command -v claude >/dev/null 2>&1; then
          # The validator is an external CLI. It has hung here; bound it rather than
          # let one third-party command hold the whole suite open indefinitely.
          vr=0
          run_bounded "$local_to" claude plugin validate "$ROOT/dist/plugin" || vr=$?
          [ "$vr" -eq 0 ] && { run_bounded "$local_to" claude plugin validate "$ROOT/dist/plugin/.claude-plugin/plugin.json" || vr=$?; }
          case "$vr" in
            0)   echo "  plugin and marketplace manifests validate";;
            124) echo "  plugin validation timed out after ${local_to}s (ACP_PLUGIN_TIMEOUT to raise it, ACP_SKIP_PLUGIN_VALIDATE=1 to skip)"; rc=1;;
            *)   echo "  plugin validation FAILED (run: claude plugin validate dist/plugin/.claude-plugin/plugin.json)"; rc=1;;
          esac
        else echo "  (claude CLI not found; plugin validation skipped)"; fi
      fi
    fi
    [ -x "$BIN/maintenance/portability-check.sh" ] && { echo "== portability"; "$BIN/maintenance/portability-check.sh" || rc=1; }
    if [ "$live" -eq 1 ]; then echo "== live sessions"; "$BIN/eval" live || rc=1; fi
    echo; [ "$rc" -eq 0 ] && echo "ALL CHECKS PASSED" || echo "CHECKS FAILED"; exit "$rc";;
  lint)          exec "$BIN/lint" "$ROOT" "$@";;
  build-plugin)  exec "$BIN/build-plugin" "$@";;
  version|-v|--version) echo "AICodePipeline $VERSION";;
  help|-h|--help)
    case "${1:-}" in
      wo|bug|playbook|pack) exec "$BIN/$1";;
      *) usage;;
    esac;;
  *) echo "acp: unknown command '$cmd'" >&2; usage >&2; exit 1;;
esac
