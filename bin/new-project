#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# new-project — empty directory to a working, pipeline-equipped project
#
#   bin/new-project <path> [--name "Display Name"] [--domain example.com]
#                          [--playbook <name>]... [--agent-set <name>]... [--skill-set <name>]... [--profile minimal|standard|full]
#                          [--no-git] [--allow-unsanitized] [--kb-level lite|standard|full]
#                          [--pipeline-dir P --code-dir C]   the P/ (pipeline) + C/ (code) layout in one repository
#
# Creates the directory, writes pipeline.config.sh from your answers, installs
# the pipeline (agents, skills, hooks, commands, harness), scaffolds the
# workspace, generates the project instructions, initialises git, and opens the
# first work order.
#
# Writes only inside <path>. The pipeline repo is never modified.
# ---------------------------------------------------------------------------
set -euo pipefail
SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

TARGET="" NAME="" DOMAIN="" DO_GIT=1 KB_LEVEL="lite" ALLOW_UNSANITIZED=0 AGENT_SETS_WANTED="" SKILL_SETS_WANTED="" PROFILE="standard"; PLAYBOOKS_WANTED=(); LAYOUT_P=""; LAYOUT_C=""
while [ $# -gt 0 ]; do
  case "$1" in
    --name)   NAME="$2"; shift 2;;
    --domain) DOMAIN="$2"; shift 2;;
    --playbook|--pack) PLAYBOOKS_WANTED+=("$2"); shift 2;;
    --agent-set|--agent-pack) AGENT_SETS_WANTED="$AGENT_SETS_WANTED $2"; shift 2;;
    --skill-set|--skill-pack) SKILL_SETS_WANTED="$SKILL_SETS_WANTED $2"; shift 2;;
    --no-git) DO_GIT=0; shift;;
    --kb-level) KB_LEVEL="$2"; shift 2;;
    --profile) PROFILE="$2"; shift 2;;
    --allow-unsanitized) ALLOW_UNSANITIZED=1; shift;;
    --pipeline-dir|--code-dir) case "${2:-}" in ""|-*) echo "new-project: $1 takes a folder name" >&2; exit 1;; esac
                     if [ "$1" = --pipeline-dir ]; then LAYOUT_P="$2"; else LAYOUT_C="$2"; fi; shift 2;;
    -h|--help) sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0;;
    -*) echo "new-project: unknown flag $1" >&2; exit 1;;
    *)  TARGET="$1"; shift;;
  esac
done
[ -n "$TARGET" ] || { sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1; }

# Every value is checked before anything is made: the name and the domain are written into
# pipeline.config.sh and other files run as shell, and the levels, sets and playbooks choose files by name.
# Character lists are spelled out, so the locale cannot widen them.
die_np() { echo "new-project: $*" >&2; exit 1; }
case "$KB_LEVEL" in lite|standard|full) ;; *) die_np "--kb-level must be lite, standard or full";; esac
case "$PROFILE" in minimal|standard|full) ;; *) die_np "--profile must be minimal, standard or full";; esac
if [ -n "$LAYOUT_P$LAYOUT_C" ]; then   # the two-folder layout: both names, each one folder, not a name the tools use, different
  for v in "$LAYOUT_P" "$LAYOUT_C"; do
    case "$v" in *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-]*|.*|-*|'') die_np "--pipeline-dir and --code-dir are given together, each one folder name (letters, digits, '.', '_', '-'; not starting with '.' or '-')";; esac
    case "$(printf '%s' "$v" | LC_ALL=C tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')" in workspace|pipeline.config.sh|agents.md|claude.md) die_np "$v is a name the layout or the tools use at the top of the repository (in any case)";; esac
  done
  [ "$(printf '%s' "$LAYOUT_P" | LC_ALL=C tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')" != "$(printf '%s' "$LAYOUT_C" | LC_ALL=C tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')" ] \
    || die_np "the pipeline folder and the code folder must differ, also ignoring case"
fi
if [ -n "$DOMAIN" ]; then
  case "$DOMAIN" in
    *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.-]*|.*|*.|-*|*-|*..*|*.-*|*-.*) die_np "--domain must be a host name such as example.com";;
    *.*) ;;
    *) die_np "--domain must be a host name such as example.com";;
  esac
  case "${DOMAIN##*.}" in   # a number such as 127.0.0.1 is not a host name; it would match other hosts' lines
    *[ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz]*) ;;
    *) die_np "--domain must be a host name such as example.com";;
  esac
fi
set -f
np_sets=""
for s in $AGENT_SETS_WANTED; do
  case "$s" in *[!abcdefghijklmnopqrstuvwxyz0123456789-]*|-*) die_np "'$s' is not an agent set name";; esac
  [ -d "$SRC/core/agents/sets/$s" ] || die_np "there is no agent set '$s' (see core/agents/sets/)"
  np_sets="$np_sets $s"
done
AGENT_SETS_WANTED="$np_sets"; np_sets=""   # written as checked: one line, single spaces
for s in $SKILL_SETS_WANTED; do
  case "$s" in *[!abcdefghijklmnopqrstuvwxyz0123456789-]*|-*) die_np "'$s' is not a skill set name";; esac
  [ -d "$SRC/core/skill-sets/$s" ] || die_np "there is no skill set '$s' (see core/skill-sets/)"
  np_sets="$np_sets $s"
done
SKILL_SETS_WANTED="$np_sets"
set +f
for p in ${PLAYBOOKS_WANTED[@]+"${PLAYBOOKS_WANTED[@]}"}; do   # a playbook is named, never reached by a path
  case "$p" in ''|.*|-*|*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-]*) die_np "'$p' is not a playbook name";; esac
done

if [ -e "$TARGET" ] && [ -n "$(ls -A "$TARGET" 2>/dev/null)" ]; then
  echo "new-project: $TARGET exists and is not empty." >&2
  echo "             Use bin/install.sh to add the pipeline to an existing project." >&2
  exit 1
fi

CREATED=0; [ -e "$TARGET" ] || CREATED=1
mkdir -p "$TARGET"
TARGET="$(cd "$TARGET" && pwd)"
BASE="$(basename "$TARGET")"
slugify() { echo "$1" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9][^a-z0-9]*/-/g' -e 's/^-//' -e 's/-$//'; }
render_claude_md() { # dest — renders core/templates/project/CLAUDE.md with the binding + stack section
  local dest="$1"
  cp "$SRC/core/templates/project/CLAUDE.md" "$dest"
  ( set -a; . "$TARGET/pipeline.config.sh"; set +a
    for v in PROJECT_NAME PROJECT_SLUG PROJECT_DOMAIN GITHUB_REPO PROJECT_ROOT PIPELINE_ROOT WORKSPACE_DIR DOCS_DIR WORKORDERS_DIR BUGS_DIR TESTING_DIR SESSIONS_DIR KNOWLEDGE_DIR API_APP ADMIN_APP PORTAL_APP DEV_APP WEB_APP SDK_PKG DB_NAME CLI_NAME API_BASE_URL WEB_ORIGIN PROJECT_DOMAIN_RE DEV_SUBDOMAINS PROD_IP; do
      VAR="$v" VAL="${!v-}" perl -pi -e 's/\{\{\Q$ENV{VAR}\E\}\}/$ENV{VAL}/g' "$dest"
    done )
  STACK_JSON="$("$SRC/bin/detect-stack" "$TARGET" --json 2>/dev/null || echo '{}')" STACKS_DIR="$SRC/core/templates/project/stacks" python3 - "$dest" "$STACK_SECTION" <<'PYEOF'
import sys, pathlib
p = pathlib.Path(sys.argv[1]); s = p.read_text().replace("{{STACK_SECTION}}", sys.argv[2])
import json, os
stacks = []
try:
    d = json.loads(os.environ.get("STACK_JSON") or "{}")
    fw, langs = d.get("frameworks", []), d.get("languages", [])
    for key, cond in (("nextjs", "nextjs" in fw), ("nestjs", "nestjs" in fw), ("golang", "golang" in langs), ("python", "python" in langs),
                      ("rust", "rust" in langs), ("php", "php" in langs), ("ruby", "ruby" in langs), ("flutter", "flutter" in fw or "dart" in langs),
                      ("java", "java" in langs and "kotlin" not in langs), ("kotlin", "kotlin" in langs), ("swift", "swift" in langs), ("csharp", "csharp" in langs),
                      ("angular", "angular" in fw), ("vue", "vue" in fw), ("svelte", "svelte" in fw), ("remix", "remix" in fw)):
        if cond: stacks.append(key)
except Exception: pass
frag = ""
for k in stacks:
    fp = os.path.join(os.environ.get("STACKS_DIR", ""), k + ".md")
    if os.path.exists(fp): frag += "\n" + open(fp).read().strip() + "\n"
if frag: s = s.replace("\n---\n\n## Where Things Live", "\n---\n" + frag + "\n---\n\n## Where Things Live", 1)
p.write_text(s)
PYEOF
}
[ -n "$NAME" ]   || NAME="$BASE"
# The name checks below refuse characters, so they run byte by byte (LC_ALL=C): in a multibyte
# locale such as Shift-JIS a refused byte can hide inside the character before it.
np_lc="${LC_ALL-}"; np_lcset="${LC_ALL+1}"; LC_ALL=C
case "$NAME" in *[[:cntrl:]]*)   # from --name or from the folder; the folder made here is removed
  [ "$CREATED" = 1 ] && rmdir "$TARGET" 2>/dev/null
  die_np "the project's name holds a newline, tab or other control character; give a --name on one line";; esac
# The name is also written into installed shell scripts, inside quotes, and into an awk pattern,
# where a bar widens the match: the characters that end or expand a quote, and the bar, are refused
# rather than escaped for one place.
case "$NAME" in *[\"\'\`\$\\/\|]*)
  [ "$CREATED" = 1 ] && rmdir "$TARGET" 2>/dev/null
  die_np "the project's name holds a quote, backtick, dollar, backslash, slash or bar; give a --name without them";; esac
if [ -n "$np_lcset" ]; then LC_ALL="$np_lc"; else unset LC_ALL; fi
[ -n "$(slugify "$NAME")" ] || { [ "$CREATED" = 1 ] && rmdir "$TARGET" 2>/dev/null
  die_np "the project's name has no letter or digit, so it gives no short name; give a --name with one"; }
SLUG="$(slugify "$NAME")"
[ -n "$DOMAIN" ] || DOMAIN="${SLUG}.local"
DOMAIN_RE="$(echo "$DOMAIN" | sed 's/\./\\./g')"

echo "Creating $NAME"
echo "  path   : $TARGET"
echo "  slug   : $SLUG"
echo "  domain : $DOMAIN"
echo

# --- 1. Project binding ----------------------------------------------------
# Each value is written as data, not as part of a sed program, so a | or & in a name is text.
# The lines are the same as before for any value the old sed wrote correctly.
NP_NAME="$NAME" NP_SLUG="$SLUG" NP_DOMAIN="$DOMAIN" NP_KB="$KB_LEVEL" NP_AS="${AGENT_SETS_WANTED# }" NP_SS="${SKILL_SETS_WANTED# }" \
  python3 -I - "$SRC/pipeline.config.example.sh" "$TARGET/pipeline.config.sh" <<'PYEOF'
import os, re, sys
src, dst = sys.argv[1:3]; e = os.environ
q = lambda v: '"' + v + '"'   # every value is checked first: none holds a quote, dollar, backtick or backslash
vals = {"PROJECT_NAME": q(e["NP_NAME"]), "PROJECT_SLUG": q(e["NP_SLUG"]), "PROJECT_DOMAIN": q(e["NP_DOMAIN"]),
        "PROJECT_DOMAIN_RE": '"' + e["NP_DOMAIN"].replace(".", "\\.") + '"',   # the domain is checked: only its dots need escaping
        "DB_NAME": q(e["NP_SLUG"].replace("-", "_") + "_dev"), "KNOWLEDGE_LEVEL": q(e["NP_KB"]),
        "AGENT_SETS": q(e["NP_AS"]), "SKILL_SETS": q(e["NP_SS"]),
        "PROJECT_ROOT": '"$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"   # the directory this file lives in; portable across clones'}
out = []
for line in open(src, encoding="utf-8").read().split("\n"):
    m = re.match(r"export ([A-Z_]+)=", line)
    if m and m.group(1) in vals: line = "export %s=%s" % (m.group(1), vals[m.group(1)])
    out.append(line)
open(dst, "w", encoding="utf-8").write("\n".join(out))
PYEOF
echo "  wrote pipeline.config.sh"
if [ -n "$LAYOUT_P" ]; then   # the code folder first: acp layout refuses a layout whose code folder is not there
  mkdir -p "$TARGET/$LAYOUT_C"; : > "$TARGET/$LAYOUT_C/.gitkeep"   # git keeps no empty folder, and install refuses a clone without it
  ( cd "$TARGET" && "$SRC/bin/acp" layout --pipeline-dir "$LAYOUT_P" --code-dir "$LAYOUT_C" ) | sed 's/^/  /'
fi

# --- 2. Install the pipeline ----------------------------------------------
# The repository comes first: install wires a git commit-msg hook, and it can only
# do that into a repository that already exists.
if [ "$DO_GIT" -eq 1 ] && command -v git >/dev/null 2>&1 && [ ! -d "$TARGET/.git" ]; then
  ( cd "$TARGET" && git init -q ) && echo "  git initialised"
fi
# Repo hygiene first: install checks that the two-folder layout keeps logs and the migration's records out of git.
cat > "$TARGET/.gitignore" <<'GIEOF'
node_modules/
__pycache__/
dist/
build/
.env
.env.local
*.log
.DS_Store
*.swp
*~
\#*#
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*
!*.pub
.venv/
venv/
coverage/
.pytest_cache/
*.tmp
GIEOF
if [ -n "$LAYOUT_P" ]; then printf '.acp-migration/\n' >> "$TARGET/.gitignore"; fi

"$SRC/bin/install.sh" "$TARGET" --profile "$PROFILE" ${LAYOUT_P:+--pipeline-dir "$LAYOUT_P" --code-dir "$LAYOUT_C"} | sed 's/^/  /'

# --- 3. Playbooks ----------------------------------------------------------
PIPELINE_ROOT_VAL="$(. "$TARGET/pipeline.config.sh"; echo "$PIPELINE_ROOT")"
DEST="$TARGET/$PIPELINE_ROOT_VAL"
PBD="$( . "$TARGET/pipeline.config.sh"; "$SRC/bin/playbook" where --project "$TARGET")"   # as install, which has checked it
if [ ${#PLAYBOOKS_WANTED[@]} -gt 0 ]; then
  mkdir -p "$PBD"
  for p in "${PLAYBOOKS_WANTED[@]}"; do
    if [ -d "$SRC/playbooks/$p" ]; then
      rc=0; "$SRC/bin/sanitize" "$SRC/playbooks/$p" --quiet >/dev/null 2>&1 || rc=$?
      if [ "$rc" -eq 2 ]; then
        if [ "$ALLOW_UNSANITIZED" -eq 0 ]; then
          echo "  REFUSED: playbook '$p' fails sanitization (secrets, PII, or internal references)." >&2
          echo "           Run: $SRC/bin/sanitize $SRC/playbooks/$p --report /tmp/$p-report.md" >&2
          echo "           Pass --allow-unsanitized only for a private, local install." >&2
          continue
        fi
      fi
      cp -R "$SRC/playbooks/$p" "$PBD/"
      echo "  playbook installed: $p ($(du -sh "$PBD/$p" | cut -f1))"
    else
      echo "  WARNING: no playbook named '$p' — available: $(ls "$SRC/playbooks" 2>/dev/null | tr '\n' ' ')" >&2
    fi
  done
  cp -p "$SRC/bin/playbook" "$DEST/bin/playbook"; chmod +x "$DEST/bin/playbook"
  ( cd "$DEST" && ./bin/playbook index >/dev/null 2>&1 ) || true
else
  echo "  no playbooks yet — 'wo promote <n>' after your first verified work order creates the first one"
fi

# --- 4. Project instructions: AGENTS.md for every agent, CLAUDE.md importing it ---
STACK_SECTION="$("$SRC/bin/detect-stack" "$TARGET" --json 2>/dev/null | python3 -c '
import json,sys
d=json.load(sys.stdin)
if d.get("empty"):
    print("- **Stack:** _(empty project — fill in once code exists, or re-run detect-stack)_")
    print("- **Run locally:** _(the command)_")
    print("- **Run tests:** _(the command)_")
else:
    print("- **Stack:** " + ", ".join(d["languages"] + d["frameworks"]) + (" (" + d["package_manager"] + ")" if d["package_manager"] else ""))
    c=d.get("commands",{})
    print("- **Run locally:** `" + c.get("run","_(the command)_") + "`")
    print("- **Run tests:** `" + c.get("test","_(the command)_") + "`")
    if c.get("build"): print("- **Build:** `" + c["build"] + "`")
    print("- **Rule sets installed:** " + ", ".join(d["rule_sets"]))
' 2>/dev/null || echo "- **Stack:** _(fill in)_")"
render_claude_md "$TARGET/AGENTS.md"
echo "  wrote AGENTS.md (the instructions every agent reads)"
cat > "$TARGET/CLAUDE.md" <<'CLEOF'
# Project instructions for Claude Code

@AGENTS.md

The instructions above are the same ones every other agent reads. What is specific to Claude Code:

- The pipeline's session hooks are registered in `.claude/settings.json` and run automatically:
  they are the early warning for the rules that `wo close`, the git hooks and CI enforce later.
- Work orders name specialist roles. Delegate each role to the subagent of that name; the
  definitions are in `.claude/agents/`.
CLEOF
echo "  wrote CLAUDE.md (imports AGENTS.md, plus what is specific to Claude Code)"

# --- 5. First commit ---------------------------------------------------------
if [ "$DO_GIT" -eq 1 ] && command -v git >/dev/null 2>&1; then
  ( cd "$TARGET" && git init -q 2>/dev/null; git add -A \
    && git commit -q -m "Initialise $NAME with AICodePipeline" ) && echo "  first commit recorded"
fi

echo
echo "Done."
echo
echo "  export PATH=\"$TARGET/$PIPELINE_ROOT_VAL/bin:\$PATH\""
echo "  cd $TARGET"
echo "  wo new \"<your first work order>\""
echo
echo "Fill in the 'Project specifics' section of AGENTS.md before your first"
echo "session — every agent reads it to locate your code."
