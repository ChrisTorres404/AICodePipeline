#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# playbook — search and manage the project's playbooks
#
# A playbook is a closed, verified work order kept for reuse: its spec, the
# suite that proved it, and the pitfalls noted at closeout. Before specifying
# anything new, search the playbooks. A problem that has already been solved,
# tested and closed out is a better starting point than a blank template.
#
#   playbook lint [name]              which catalog entries still have no pitfalls
#   playbook list                     list installed playbooks
#   playbook new <name>               scaffold an empty playbook
#   playbook search <term>            full text across every playbook
#   playbook wo <term>                work orders only
#   playbook bug <term>               bugs only
#   playbook suite <term>             behavioral test suites only
#   playbook arch <term>              architecture and schema documents
#   playbook show <WO-####|BUG-####>  list a folder's documents
#   playbook catalog [name]           rebuild CATALOG.md from catalog/ (promotions write entries there)
#   playbook index                    regenerate playbooks/INDEX.md
#   playbook where [--project D]      print the playbooks folder (PLAYBOOKS_DIR), or refuse it
#
# Scope to one playbook with PLAYBOOK=<name>, e.g. PLAYBOOK=my-domain playbook wo caching
# ---------------------------------------------------------------------------
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# The playbooks folder, decided here alone; wo, bug, install, new-project and doctor ask `playbook where`.
# PLAYBOOKS_DIR (or PACKS_DIR, its name before 1.4.0) from the environment, else read as data from this install's
# own pipeline.config.sh (the first one above it whose PIPELINE_ROOT is this install; --project names it), is
# relative to the project like every *_DIR, or absolute. A relative one lies under the pipeline's or the
# workspace's top folder; no spelling or link of it lies in the code folder, where the fingerprint would read
# promoted playbooks as code. Anything else is refused. Unset, the folder is inside the install, as before.
pbq() { printf 'playbook: %s\n' "$1" >&2; exit "${2:-1}"; }
PR1='$PROJECT_ROOT/' PR2='${PROJECT_ROOT}/'
cfgv() { # <NAME>: its value in $PCFG, read as data, "" when unset; status 2 when it is set some other way
  local all v; all="$(grep -v '^[[:space:]]*#' "$PCFG" | grep -cE "(^|[^A-Za-z0-9_])$1=" || true)"
  [ "$all" -eq 0 ] && return 0
  v="$(sed -n "s/^export $1=\"\([^\"]*\)\".*/\1/p" "$PCFG")"; v="${v#"$PR1"}"; v="${v#"$PR2"}"
  [ "$all" -eq 1 ] && [ -n "$(sed -n "/^export $1=\"[^\"]*\"/p" "$PCFG")" ] || return 2
  case "$v" in *'$'*|*'`'*|*\\*) return 2;; esac; printf '%s' "$v"
}
PCFG="" PROJ="" BASE="$ROOT"
if [ "${1:-}" = where ] && [ "${2:-}" = --project ]; then
  [ -f "${3:-}/pipeline.config.sh" ] || pbq "usage: playbook where [--project <folder holding pipeline.config.sh>]"
  PCFG="$3/pipeline.config.sh"; PROJ="$(cd "$3" && pwd -P)"
  pr="$(cfgv PIPELINE_ROOT)" && [ -n "$pr" ] || pbq "pipeline.config.sh sets PIPELINE_ROOT in a form that cannot be read as data"
  BASE="$PROJ/$pr"
else
  d="$ROOT"; while [ "$d" != / ] && [ ! -f "$d/pipeline.config.sh" ]; do d="$(dirname "$d")"; done
  if [ -f "$d/pipeline.config.sh" ]; then
    PCFG="$d/pipeline.config.sh"; pr="$(cfgv PIPELINE_ROOT || true)"
    if [ -n "$pr" ] && [ "$(cd "$d" && cd "$pr" 2>/dev/null && pwd -P)" = "$ROOT" ]; then PROJ="$(cd "$d" && pwd -P)"; else PCFG=""; fi
  fi
fi
PLAYBOOKS="${PLAYBOOKS_DIR:-${PACKS_DIR:-}}"
if [ -z "$PLAYBOOKS" ] && [ -n "$PCFG" ]; then
  rc=0; PLAYBOOKS="$(cfgv PLAYBOOKS_DIR)" || rc=$?
  [ "$rc" -eq 0 ] || pbq "pipeline.config.sh sets PLAYBOOKS_DIR in a form that cannot be read as data; write it as  export PLAYBOOKS_DIR=\"<folder>\"" 2
fi
if [ -z "$PLAYBOOKS" ]; then
  if [ ! -d "$BASE/playbooks" ] && [ -d "$BASE/packs" ]; then PLAYBOOKS="$BASE/packs"; else PLAYBOOKS="$BASE/playbooks"; fi
else
  pbraw="$PLAYBOOKS"; pbbad() { pbq "$(printf 'PLAYBOOKS_DIR %q %s' "$pbraw" "$1")"; }
  case "$PLAYBOOKS" in *$'\n'*|*$'\r'*|-*) pbbad "must be a folder path, not starting with -";; esac
  pbs=//; while case "$PLAYBOOKS" in *//*) true;; *) false;; esac; do PLAYBOOKS="${PLAYBOOKS//$pbs//}"; done   # a//b names the folder a/b
  case "$PLAYBOOKS" in /*) pbabs=1;; *) pbabs=""; PLAYBOOKS="${PLAYBOOKS#./}";; esac
  while [ "${PLAYBOOKS%/}" != "$PLAYBOOKS" ]; do PLAYBOOKS="${PLAYBOOKS%/}"; done
  case "$PLAYBOOKS" in ''|.|..|../*|*/..|*/../*|*/./*|*/.|./*) pbbad "must be a folder path without . or ..";; esac
  [ -n "$pbabs" ] || [ -n "$PROJ" ] || pbbad "is relative, but no pipeline.config.sh names this install, so there is no project to resolve it in"
  pbcode="."
  if [ -n "$PROJ" ]; then
    rc=0; pbcode="$(cfgv CODE_DIR)" || rc=$?; [ "$rc" -eq 0 ] || pbbad "cannot be checked: pipeline.config.sh sets CODE_DIR in a form that cannot be read as data"
    pbcode="${pbcode:-${CODE_DIR:-.}}"; pbcode="${pbcode#./}"; while [ "${pbcode%/}" != "$pbcode" ]; do pbcode="${pbcode%/}"; done; pbcode="${pbcode:-.}"
  fi
  pbrel() { # <path relative to the project>: beside the pipeline and the workspace, outside the code folder
    [ "$pbcode" != . ] || pbbad "lies inside the code folder (CODE_DIR is the whole project): the fingerprint would read promoted playbooks as code"
    local t1 t2; t1="$(cfgv PIPELINE_ROOT || true)"; t1="${t1#./}"; t2="$(cfgv WORKSPACE_DIR || true)"; t2="${t2#./}"
    case "${1%%/*}" in "${t1%%/*}"|"${t2%%/*}") ;; *) pbbad "must lie under ${t1%%/*}/ or ${t2%%/*}/, beside the pipeline and the workspace";; esac
  }
  [ -n "$pbabs" ] || pbrel "$PLAYBOOKS"
  # The folder as it is on disk: its deepest existing folder with every link resolved, then the part still to be
  # made, none of which may exist yet (a file or a link to nothing on the way is refused).
  d="$PLAYBOOKS"; [ -n "$pbabs" ] || d="$PROJ/$PLAYBOOKS"; rest=""
  while [ ! -d "$d" ]; do
    { [ ! -e "$d" ] && [ ! -L "$d" ]; } || pbbad "is not a folder (a file, or a link to nothing)"
    rest="/${d##*/}$rest"; d="$(dirname "$d")"
  done
  d="$(cd "$d" && pwd -P)"
  if [ -n "$PROJ" ]; then   # each folder above it on disk: never the code folder; inside the project, the relative rules hold
    a="$d" inproj=""
    while :; do
      [ "$pbcode" = . ] || [ ! "$a" -ef "$PROJ/$pbcode" ] || pbbad "lies inside the code folder ($pbcode), through a link or another spelling: the fingerprint would read promoted playbooks as code"
      [ -n "$inproj" ] || [ ! "$a" -ef "$PROJ" ] || inproj="$a"
      [ "$a" != / ] || break; a="$(dirname "$a")"
    done
    if [ -n "$pbabs" ] && [ -n "$inproj" ]; then
      pbr="${d#"$inproj"}$rest"; pbr="${pbr#/}"; [ -n "$pbr" ] || pbbad "is the project itself"; pbrel "$pbr"
    fi
  fi
  PLAYBOOKS="${d%/}$rest"
fi
[ "${1:-}" != where ] || { printf '%s\n' "$PLAYBOOKS"; exit 0; }
[ -d "$PLAYBOOKS" ] || mkdir -p "$PLAYBOOKS"

SELECTED="${PLAYBOOK:-${PACK:-}}"
if [ -n "$SELECTED" ]; then
  [ -d "$PLAYBOOKS/$SELECTED" ] || { echo "playbook: no playbook named '$SELECTED'" >&2; exit 1; }
  ROOTS=("$PLAYBOOKS/$SELECTED")
else
  ROOTS=()
  for d in "$PLAYBOOKS"/*/; do [ -d "$d" ] && ROOTS+=("${d%/}"); done
fi
# Commands that read playbooks need at least one; `new`, `list`, and `index`
# must work on an empty directory, the state of every fresh install.
case "${1:-}" in
  search|wo|bug|suite|arch|show)
    [ ${#ROOTS[@]} -gt 0 ] || { echo "playbook: no playbooks yet — nothing to search. 'wo promote <n>' after your first verified work order creates one." >&2; exit 0; };;
esac

hl() { printf '\033[1m%s\033[0m\n' "$*"; }

search_catalog() { # term — catalog entries whose text mentions the term, with their pitfalls
  local term="$1" any=0
  for r in "${ROOTS[@]+"${ROOTS[@]}"}"; do
    src="$r/CATALOG.md"; [ -n "$(ls -A "$r/catalog" 2>/dev/null)" ] && src="$r/catalog"
    [ -e "$src" ] || continue
    python3 - "$src" "$term" "$(basename "$r")" <<'PYEOF' && any=1
import re, sys, os, glob
path, term, name = sys.argv[1:4]
if os.path.isdir(path):
    t = "".join(open(f).read().rstrip("\n") + "\n\n" for f in sorted(glob.glob(os.path.join(path, "*.md"))))
else:
    t = open(path).read()
entries = re.split(r"(?m)^## ", t)[1:]
hits = [e for e in entries if re.search(re.escape(term), e, re.I)]
if not hits: sys.exit(1)
print("\033[1mCATALOG — %s\033[0m" % name)
for e in hits:
    head, _, body = e.partition("\n")
    folder = re.search(r"\*\*Folder:\*\* `([^`]+)`", body)
    pit = re.search(r"(?ms)\*\*Pitfalls:\*\*\n(.*?)(?=\n- \*\*|\Z)", body)
    print("  " + head.strip())
    if folder: print("    folder:   " + folder.group(1))
    if pit:
        for line in [l.strip() for l in pit.group(1).splitlines() if l.strip()][:4]: print("    pitfall:  " + line)
print()
PYEOF
  done
  return 0
}
search_sub() { # subdir term label — folders under the playbook whose documents mention the term
  local sub="$1" term="$2" label="$3" any=0 hits
  for r in "${ROOTS[@]+"${ROOTS[@]}"}"; do
    [ -d "$r/$sub" ] || continue
    # Paths are read as lines and cut as data: xargs split a folder name at a space and stopped at a
    # quote, and the prefix went into sed program text, so a | or & in the playbooks path broke it.
    hits="$(grep -rils --include='*.md' -- "$term" "$r/$sub" 2>/dev/null | { grep -v -e '\.log$' -e '\.wo-meta' || true; } \
      | while IFS= read -r f; do printf '%s\n' "${f%/*}"; done | sort -u | head -20 || true)"
    [ -z "$hits" ] && continue
    [ "$any" -eq 0 ] && { hl "$label"; any=1; }
    printf '%s\n' "$hits" | while IFS= read -r h; do printf '  %s\n' "${h#"$PLAYBOOKS"/}"; done
  done
  [ "$any" -eq 1 ] && echo
  return 0
}

case "${1:-}" in
  new)
    name="${2:?usage: playbook new <name>}"
    case "$name" in *[!a-z0-9-]*) echo "playbook: name must be lowercase letters, digits, hyphens" >&2; exit 1;; esac
    d="$PLAYBOOKS/$name"; [ -e "$d" ] && { echo "playbook: $d already exists" >&2; exit 1; }
    mkdir -p "$d/catalog"; printf '# Generated from catalog/ by `playbook catalog`; the entry files are the source of truth.\nCATALOG.md\n' > "$d/.gitignore"
    mkdir -p "$d"/{workorders,bugs,test-suites,architecture}
    for sub in workorders bugs test-suites architecture; do : > "$d/$sub/.gitkeep"; done
    cat > "$d/README.md" <<MD
# Playbook: $name

Closed, verified work kept for reuse. \`wo promote\` and \`bug promote\` add
sanitized work into it and append entries to \`CATALOG.md\`.

| Folder | Holds |
|---|---|
| \`workorders/<project>/\` | promoted work orders, structure intact |
| \`bugs/\` | promoted bug folders |
| \`test-suites/\` | behavioral suites worth reusing |
| \`architecture/\` | design documents and schema |
| \`catalog/\` | one file per promoted item, with pitfalls (edit these) |
| \`CATALOG.md\` | generated from \`catalog/\` by \`playbook catalog\` |

Run \`bin/sanitize\` on this playbook before sharing it.
MD
    echo "playbook created: $d"
    ;;
  lint)
    # The pitfalls are the part of a playbook the next project needs, and
    # promote asks for them rather than refusing. This is where that is checked.
    name="${2:-}"; rc=0; total=0; empty=0
    for r in "${ROOTS[@]+"${ROOTS[@]}"}"; do
      [ -n "$name" ] && [ "$(basename "$r")" != "$name" ] && continue
      for e in "$r"/catalog/*.md; do
        [ -f "$e" ] || continue
        total=$((total+1))
        if grep -qE '_\(none recorded|\[Lesson [0-9]|\[What would have saved' "$e" 2>/dev/null; then empty=$((empty+1)); echo "  no pitfalls recorded: ${e#$PLAYBOOKS/}"; rc=1; fi
      done
    done
    [ "$total" -gt 0 ] || { echo "playbook lint: no catalog entries yet"; exit 0; }
    echo "playbook lint: $total entries, $empty without pitfalls"
    [ "$rc" -eq 0 ] && echo "  every entry carries what would have saved someone time" || echo "  edit the Pitfalls lines above; an entry without pitfalls records the work but not what it taught"
    exit "$rc";;
  list|playbooks|packs)
    [ ${#ROOTS[@]} -gt 0 ] || { echo "no playbooks yet — playbook new <name>, then wo promote"; exit 0; }
    printf "%-24s %8s %10s  %s\n" "PLAYBOOK" "FILES" "SIZE" "CONTENTS"
    for r in "${ROOTS[@]+"${ROOTS[@]}"}"; do
      c=""
      for s in workorders bugs test-suites architecture audits reference ui-scenarios; do
        [ -d "$r/$s" ] && c="$c $s"
      done
      printf "%-24s %8s %10s %s\n" "$(basename "$r")" \
        "$(find "$r" -type f | wc -l | tr -d ' ')" "$(du -sh "$r" | cut -f1)" "$c"
    done
    ;;
  search)
    t="${2:?usage: playbook search <term>}"
    search_catalog "$t"
    search_sub workorders   "$t" "WORK ORDERS"
    search_sub bugs         "$t" "BUGS"
    search_sub test-suites  "$t" "TEST SUITES"
    search_sub architecture "$t" "ARCHITECTURE"
    ;;
  wo)    search_sub workorders   "${2:?usage: playbook wo <term>}"    "WORK ORDERS";;
  bug)   search_sub bugs         "${2:?usage: playbook bug <term>}"   "BUGS";;
  suite) search_sub test-suites  "${2:?usage: playbook suite <term>}" "TEST SUITES";;
  arch)  search_sub architecture "${2:?usage: playbook arch <term>}"  "ARCHITECTURE";;
  show)
    id="${2:?usage: playbook show <WO-####|BUG-####>}"; found=0
    for r in "${ROOTS[@]+"${ROOTS[@]}"}"; do
      while IFS= read -r d; do
        found=1; hl "${d#"$PLAYBOOKS"/}"; ls "$d" | sed 's/^/    /'; echo   # the prefix quoted: a literal, not a pattern
      done < <(find "$r" -type d -iname "${id}*" 2>/dev/null)
    done
    if [ "$found" -eq 0 ]; then echo "playbook: no folder matching $id" >&2; exit 1; fi
    ;;
  catalog)
    want="${2:-}"
    for r in "${ROOTS[@]+"${ROOTS[@]}"}"; do
      name="$(basename "$r")"; [ -n "$want" ] && [ "$want" != "$name" ] && continue
      mkdir -p "$r/catalog"
      # migrate a legacy single-file catalog into per-item entries once
      if [ -f "$r/CATALOG.md" ] && [ -z "$(ls -A "$r/catalog" 2>/dev/null)" ] && grep -q "^## " "$r/CATALOG.md"; then
        python3 - "$r/CATALOG.md" "$r/catalog" <<'PYEOF'
import re, sys, os, pathlib
src, out = sys.argv[1:3]
t = open(src).read()
for m in re.finditer(r"(?ms)^## ((?:WO|BUG)-\d+)[^\n]*\n.*?(?=^## |\Z)", t):
    pathlib.Path(out, m.group(1) + ".md").write_text(m.group(0).rstrip("\n") + "\n")
print(f"  migrated {len(re.findall(r'(?m)^## (?:WO|BUG)-', t))} legacy catalog entr(ies) into catalog/")
PYEOF
      fi
      # CATALOG.md is generated from catalog/; keeping it untracked is what makes
      # concurrent promotions merge cleanly. The entries are the source of truth.
      printf '# Generated from catalog/ by `playbook catalog`; the entry files are the source of truth.\nCATALOG.md\n' > "$r/.gitignore"
      { printf '# Playbook catalog: %s\n\n' "$name"
        printf 'Generated by `playbook catalog` from `catalog/`. One file per promoted item, so\n'
        printf 'parallel promotions never touch the same file. Edit the **Pitfalls** lines in\n'
        printf 'the entry files — they are the most valuable part.\n\n'
        for f in "$r"/catalog/*.md; do [ -f "$f" ] && { cat "$f"; printf '\n'; }; done
      } > "$r/CATALOG.md"
      echo "wrote $r/CATALOG.md ($(ls "$r"/catalog/*.md 2>/dev/null | wc -l | tr -d ' ') entries)"
    done
    ;;
  index)
    out="$PLAYBOOKS/INDEX.md"
    if [ ${#ROOTS[@]} -eq 0 ]; then
      printf '# Playbook Index\n\nNo playbooks yet. Create one with `playbook new <name>`, then `wo promote` verified work into it.\n' > "$out"
      echo "wrote $out (no playbooks)"; exit 0
    fi
    {
      echo "# Playbook Index"
      echo
      echo "Generated by \`bin/playbook index\`. Search with \`bin/playbook search <term>\`."
      echo
      echo "Lifecycle notation: \`SCTPVC\` = **S**pec, **C**hecklist,"
      echo "**T**ask-breakdown, **P**rompt, **V**erification, **C**loseout."
      echo "A dot is a document that was never written."
      echo
      for r in "${ROOTS[@]+"${ROOTS[@]}"}"; do
        name="$(basename "$r")"
        echo "---"; echo; echo "# Playbook: $name"; echo
        for d in "$r"/workorders/*/; do
          [ -d "$d" ] || continue
          echo "## Work orders — $(basename "$d") ($(find "$d" -maxdepth 1 -type d | tail -n +2 | wc -l | tr -d ' '))"
          echo; echo "| WO | Docs | Title |"; echo "|---|---|---|"
          for f in "$d"WO-*; do
            [ -d "$f" ] || continue
            b="$(basename "$f")"; n="${b#WO-}"; n="${n%%-*}"; st=""
            for k in SPEC CHECKLIST TASK-BREAKDOWN Prompt VERIFICATION CLOSEOUT; do
              if ls "$f" 2>/dev/null | grep -qi -- "-$k"; then st="$st${k:0:1}"; else st="$st."; fi
            done
            echo "| WO-$n | \`$st\` | ${b#WO-$n-} |"
          done
          echo
        done
        if [ -d "$r/bugs" ]; then
          echo "## Bugs ($(find "$r/bugs" -maxdepth 1 -type d | tail -n +2 | wc -l | tr -d ' '))"
          echo; echo "| Bug | State | Title |"; echo "|---|---|---|"
          for f in "$r"/bugs/BUG-*; do
            [ -d "$f" ] || continue
            b="$(basename "$f")"; n="${b#BUG-}"; n="${n%%-*}"
            if ls "$f" 2>/dev/null | grep -qi CLOSEOUT; then s=fixed; else s=open; fi
            echo "| BUG-$n | $s | ${b#BUG-$n-} |"
          done
          echo
        fi
        if [ -d "$r/test-suites" ]; then
          echo "## Behavioral test suites ($(ls "$r"/test-suites/*.sh 2>/dev/null | wc -l | tr -d ' '))"
          echo
          for f in "$r"/test-suites/*.sh; do
            [ -f "$f" ] && echo "- \`$(basename "$f")\` ($(wc -l < "$f" | tr -d ' ') lines)"
          done
          echo
        fi
      done
    } > "$out"
    echo "wrote $out ($(wc -l < "$out" | tr -d ' ') lines)"
    ;;
  *) sed -n '2,23p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1;;
esac
