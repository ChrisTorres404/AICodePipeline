#!/usr/bin/env python3
"""
sanitize — scan a directory for material that must not be shared.

Secrets, personal identifiers, internal infrastructure (private and public IPs,
SSH strings, key-file references, and internal host names), host-specific paths,
and dangerous files. Read-only: it reports, it never edits. A single CRITICAL
finding is a FAIL. Warnings alone are PASS WITH WARNINGS.

Internal host names are reported at WARNING: a name is a judgement call that no
regex settles on its own, so the rule is tuned to put a human in front of the
finding rather than to fail a release.

    bin/sanitize <dir> [--report <file.md>] [--allow <regex>]... [--include-logs] [--quiet]

.log files are not read unless --include-logs is given: a default scan is unchanged, so a
playbook that already holds run logs does not start failing; promote will ask for them.

A file named .sanitize-ignore in <dir> lists relative paths to skip, one per
line, for files that legitimately contain patterns (a substitution table, a
pattern list). Use it sparingly and never for real secrets.

Exit codes: 0 PASS, 1 PASS WITH WARNINGS, 2 FAIL, 3 usage error.

Used by bin/install.sh and bin/new-project to refuse installing a playbook that
fails, unless --allow-unsanitized is passed to them.
"""
import argparse, os, re, sys
from datetime import date

TEXT_EXT = {".md", ".txt", ".sh", ".py", ".js", ".ts", ".tsx", ".jsx", ".json",
            ".yaml", ".yml", ".env", ".sql", ".toml", ".ini", ".cfg", ".conf",
            ".html", ".css", ".xml", ".csv", ".rb", ".go", ".rs", ".java", ".kt",
            ".php", ".cs", ".swift", ".mjs", ".cjs", ".example", ""}
SKIP_DIRS = {"node_modules", ".git", "__pycache__", ".venv", "venv", "dist",
             "build", ".next", ".turbo", "coverage"}

# --- internal host names ---------------------------------------------------
# api.github.com and iam-core.hollow-a.da11.delivery.engineering have the same
# shape, so shape alone cannot separate a published documentation host from an
# internal one. Two signals do, in practice:
#
#   1. a suffix reserved for private networks (.internal, .corp, .local, .lan,
#      .intranet, .home.arpa) — always internal, whatever the depth;
#   2. depth under an unusual top-level domain — three or more labels ending in
#      something outside the handful of TLDs that public documentation, package
#      registries and schema URLs actually use — AND some sign that the token is
#      a host at all: a hyphen or a digit in one of its labels, a scheme or `@`
#      in front of it, or a port behind it. Without that last condition the rule
#      is drowned by dotted identifier chains, which have exactly the same shape:
#      django.db.models, org.junit.jupiter, this.state.value, build.gradle.kts.
#
# Anything a regex reaches this way is a guess, which is why the finding is a
# WARNING: it makes a human look at the name instead of failing the release.
INTERNAL_SUFFIXES = {"internal", "corp", "local", "lan", "intranet"}

# Deliberately short. Widening it hides internal hosts; the cost of a name that
# is not on it is one warning a reviewer dismisses.
PUBLIC_TLDS = {"com", "org", "net", "io", "dev", "app", "edu", "gov", "co", "uk",
               "de", "fr", "ca", "au", "ai", "me", "info", "cloud", "sh", "xyz",
               "ly", "tv", "us", "eu", "nl", "se", "ch", "jp", "in", "br",
               "tech", "page", "site", "design"}

# A dotted token whose last segment is a file extension is a filename, not a
# host: settings.hooks.json, pipeline.config.example.sh, tsconfig.build.json.
HOST_FILE_EXT = {e.lstrip(".") for e in TEXT_EXT if e} | {
    "lock", "log", "bak", "tmp", "orig", "patch", "diff", "snap", "map", "d",
    "gz", "tgz", "bz2", "zip", "tar", "xz", "png", "jpg", "jpeg", "gif", "svg",
    "webp", "ico", "pdf", "woff", "woff2", "ttf", "eot", "mp4", "webm", "wasm",
    "pem", "key", "crt", "cer", "p12", "pfx", "jks", "der", "pub", "dist",
    "min", "test", "spec", "stories", "config", "sample", "template",
    "bundle", "chunk", "types", "schema", "proto", "gradle", "kts", "properties"}

# Roots of dotted identifier chains in the languages the playbooks carry code for.
# Nothing that starts with one of these is a host name.
CODE_ROOT_LABELS = {"self", "this", "cls", "super", "window", "document", "process",
                    "module", "exports", "console", "globalthis", "navigator"}

# Documentation stand-ins. A name containing one of these is teaching, not leaking.
PLACEHOLDER_LABELS = {"example", "examples", "sample", "placeholder", "changeme",
                      "your", "yourdomain", "yourcompany", "yourorg", "mycompany",
                      "myproject", "mydomain", "acme", "foo", "bar", "baz", "qux",
                      "todo", "tbd", "xxx", "somewhere", "somehost", "host",
                      "hostname", "domain", "subdomain", "invalid", "test",
                      "localhost", "project", "tenant", "customer"}

# Lowercase only, on purpose: a real FQDN in a leaked config is lowercase, and
# requiring it keeps Caddyfile.local and CHANGELOG.md out of the results.
HOSTNAME_RE = re.compile(r"(?<![\w.\-])((?:[a-z0-9](?:[a-z0-9\-]*[a-z0-9])?\.)+[a-z][a-z0-9\-]*[a-z0-9])(?![\w\-])")

def _inside_placeholder(line, start, end):
    """True when the match sits inside {{...}}, <...> or ${...} — a template slot."""
    for op, cl in (("{{", "}}"), ("<", ">"), ("${", "}")):
        i = line.rfind(op, 0, start)
        if i == -1:
            continue
        j = line.find(cl, i + len(op))
        if j >= end:
            return True
    return False

def _looks_like_host(labels, line, start, end):
    """Separate a deep host name from a dotted identifier chain of the same shape.

    Identifiers cannot contain a hyphen and rarely carry a digit, so a hyphen or
    digit in any label but the last is strong evidence of a host. Failing that,
    the surrounding text has to place it where only a host can go."""
    if any("-" in l or any(c.isdigit() for c in l) for l in labels[:-1]):
        return True
    before = line[:start]
    if before.endswith(("://", "//")):
        return True
    # `user@host`, not the `@pytest.mark.slow` and `@ohos.data.preferences` of
    # decorators and module ids: an `@` only places a host when a user precedes it.
    if re.search(r"[A-Za-z0-9_.\-]@$", before):
        return True
    return re.match(r":\d{2,5}(?!\d)", line[end:]) is not None

def hostname_is_internal(m, line):
    """Decide whether a dotted lowercase token is worth a reviewer's attention."""
    host = m.group(1)
    start, end = m.span(1)
    if _inside_placeholder(line, start, end):
        return False
    # `os.path.join(` and `str.split(` are attribute chains, not hosts.
    if end < len(line) and line[end] == "(":
        return False
    labels = host.split(".")
    if len(host) > 253 or any(len(l) > 63 for l in labels):
        return False
    if all(l.isdigit() for l in labels):                           # 1.0.0, 2.11.4
        return False
    if labels[0] in CODE_ROOT_LABELS or any(l in PLACEHOLDER_LABELS for l in labels):
        return False
    # No top-level domain carries a digit; a trailing v1/x86/2 is a version or an id.
    if any(c.isdigit() for c in labels[-1]):
        return False
    # A reserved private suffix is decisive on its own, whatever the depth.
    if host.endswith(".home.arpa") or labels[-1] in INTERNAL_SUFFIXES:
        return True
    if labels[-1] in HOST_FILE_EXT:
        return False
    if len(labels) < 3 or labels[-1] in PUBLIC_TLDS:
        return False
    return _looks_like_host(labels, line, start, end)

# --- email addresses ---------------------------------------------------------
# An address at a personal mail provider is a CRITICAL `pii.email` finding, in every
# mode. Any other address is an `email.address` WARNING: a work or project address may
# be a public contact a reviewer keeps, but a person has to look at it. Not reported:
# the reserved documentation names (RFC 2606, RFC 6761), noreply senders, and the
# shapes that only look like an address: a URL's user part (scheme://user:pass@host),
# git@host: remotes, package pins (name@1.2.3: no alphabetic top-level domain, so the
# regex never matches) and image density names (icon@2x.png).
PERSONAL_DOMAIN_RE = re.compile(r"(?i:(gmail|yahoo|hotmail|outlook|protonmail|icloud|me|aol)\.(com|net|org))(?![A-Za-z0-9])")
# Both ends are bounded like EMAIL_RE's (look-arounds, not \b), so pii.email reports an address
# exactly when email_is_reportable's domain test skips it, and neither regex retries inside a
# long run of user-part characters.
PERSONAL_EMAIL_RE = re.compile(r"(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@" + PERSONAL_DOMAIN_RE.pattern)
EMAIL_RE = re.compile(r"(?<![A-Za-z0-9._%+-])([A-Za-z0-9._%+-]+)@((?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\.)+([A-Za-z]{2,63}))(?![A-Za-z0-9-])")
RESERVED_EMAIL_DOMAINS = {"example.com", "example.net", "example.org"}
RESERVED_EMAIL_TLDS = {"test", "example", "invalid", "localhost"}
NOREPLY_EMAIL_USERS = {"noreply", "no-reply"}
NOREPLY_EMAIL_DOMAINS = {"users.noreply.github.com"}

def _is_or_under(domain, names):
    return any(domain == d or domain.endswith("." + d) for d in names)

# Look back this far at most: a URL's scheme://user:pass@ is never longer, and the bound
# keeps the work per match constant on a minified line holding thousands of matches.
URL_LOOKBACK = 512
# Characters that end a URL before a user part could start, as in minified JSON:
# {"homepage":"https://host","author":"name@host"}.
URL_USER_PART_STOPS = "\"'<>()[]{},;`|\\"

def _in_url_user_part(line, start):
    """True when the text before `start` is scheme://user[:pass]@, even with an @ in the password."""
    window = line[max(0, start - URL_LOOKBACK):start]
    tok = "" if not window or window[-1].isspace() else window.split()[-1]   # any Unicode whitespace
    tok = tok[max(tok.rfind(c) for c in URL_USER_PART_STOPS) + 1:]
    i = tok.rfind("://")
    return i > 0 and (tok[i - 1].isalnum() or tok[i - 1] in "+.-") and "/" not in tok[i + 3:]

def email_is_reportable(m, line):
    """True for an address that is not personal (pii.email reports those), reserved, noreply, or not an address."""
    user, domain, tld = m.group(1).lower(), m.group(2).lower(), m.group(3).lower()
    if PERSONAL_DOMAIN_RE.match(domain):                                 # pii.email reports it
        return False
    if _is_or_under(domain, RESERVED_EMAIL_DOMAINS) or tld in RESERVED_EMAIL_TLDS:
        return False
    if user in NOREPLY_EMAIL_USERS or _is_or_under(domain, NOREPLY_EMAIL_DOMAINS):
        return False
    if user == "git":                                                    # git@host:org/repo.git
        return False
    if _in_url_user_part(line, m.start()):                              # scheme://user:pass@host
        return False
    return re.match(r"\d+(?:\.\d+)?x\.", domain) is None                  # icon@2x.png

# A pattern may name a predicate here; a match it rejects is not a finding, and
# the scan carries on to the remaining patterns for that line.
VALIDATORS = {"infra.hostname": hostname_is_internal, "email.address": email_is_reportable}

# (id, severity, regex, label)  — severity: CRITICAL | WARNING
PATTERNS = [
    ("secret.apikey",  "CRITICAL", re.compile(r"(?i)\b(api[_-]?key|apikey|api[_-]?secret|client[_-]?secret)\b\s*[:=]\s*['\"]?[A-Za-z0-9+/=_\-]{16,}"), "API key or client secret"),
    ("secret.pk",      "CRITICAL", re.compile(r"\bpk_(test|live)_[A-Za-z0-9]{16,}"), "publishable/test key"),
    ("secret.sk",      "CRITICAL", re.compile(r"\b[sr]k_(test|live)_[A-Za-z0-9]{16,}"), "secret or restricted key"),
    ("secret.stripewh","CRITICAL", re.compile(r"\bwhsec_[A-Za-z0-9]{32,}"), "Stripe webhook secret"),
    ("secret.aws",     "CRITICAL", re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "AWS access key id"),
    ("secret.awstemp", "CRITICAL", re.compile(r"\bASIA[0-9A-Z]{16}\b"), "AWS temporary access key id"),
    ("secret.awssec",  "CRITICAL", re.compile(r"(?i)aws_secret(_access)?_key\s*[:=]\s*['\"]?[A-Za-z0-9+/=]{20,}"), "AWS secret key"),
    # What makes a connection URL dangerous is the password, not the username: key
    # the exemption off the secret itself, so a rendered project slug does not
    # turn an obvious placeholder into a critical finding.
    ("secret.dburl",   "CRITICAL", re.compile(r"\b(?:postgres(?:ql)?|mysql|mongodb(?:\+srv)?|redis|amqp|mssql)://(?P<dbuser>[^:/\s@'\"]+):(?!\$\{|\{\{|<|(?P=dbuser)@|\w*(?:pass|secret|token)\w*@|%s)[^@\s'\"]{3,}@" % "|".join(("pass","password","passwd","secret","changeme","example","placeholder","your","xxx","redacted","dbpass","pwd"))), "database URL with credentials"),
    ("secret.jwt",     "CRITICAL", re.compile(r"\beyJ[A-Za-z0-9_-]{20,}\.eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{10,}"), "JWT"),
    ("secret.privkey", "CRITICAL", re.compile(r"-----BEGIN\s+(?:[A-Z0-9]+\s+)*PRIVATE KEY-----"), "private key"),
    ("secret.pgp",     "CRITICAL", re.compile(r"-{5}BEGIN PGP PRIVATE KEY BLOCK-{5}"), "PGP private key"),
    ("secret.github",  "CRITICAL", re.compile(r"\b(gh[pousr]_[A-Za-z0-9_]{36,}|github_pat_[A-Za-z0-9_]{22,})"), "GitHub token"),
    ("secret.google",  "CRITICAL", re.compile(r"\bGOCSPX-[A-Za-z0-9_-]+"), "Google OAuth secret"),
    ("secret.googlekey","CRITICAL", re.compile(r"\bAIza[0-9A-Za-z_-]{35}(?![0-9A-Za-z_-])"), "Google API key"),
    ("secret.openai",  "CRITICAL", re.compile(r"\bsk-(?:proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|\bsk-[A-Za-z0-9]{20}T3BlbkFJ[A-Za-z0-9]{20}\b"), "OpenAI key"),
    ("secret.anthropic","CRITICAL", re.compile(r"\bsk-ant-[A-Za-z0-9_-]{20,}"), "Anthropic API key"),
    ("secret.gitlab",  "CRITICAL", re.compile(r"\bgl(?:pat|dt|rt|ptt|cbt|soat|ft|imt|oas)-[A-Za-z0-9_-]{20,}"), "GitLab token"),
    ("secret.slacktok","CRITICAL", re.compile(r"\bxox[abeposr]-[0-9]+-[0-9A-Za-z-]{10,}|\bxapp-[0-9]+-[A-Za-z0-9]+-[0-9]+-[A-Za-z0-9]{20,}"), "Slack token"),
    ("secret.slack",   "CRITICAL", re.compile(r"https://hooks\.slack\.com/services/T[A-Z0-9]+/B[A-Z0-9]+/[A-Za-z0-9]+"), "Slack webhook"),
    ("secret.sendgrid","CRITICAL", re.compile(r"\bSG\.[A-Za-z0-9_-]{22}\.[A-Za-z0-9_-]{43}"), "SendGrid key"),
    ("secret.password","CRITICAL", re.compile(r"(?i:\b(password|passwd|pwd|pgpassword|db_pass(word)?|mysql_pwd)\b\s*[:=]\s*['\"](?!\$\{|\{\{|<|test|example|changeme|placeholder|mysecret|secret|hunter2|s3cr3t|your[_-]?)[^'\"\s]{6,}['\"])"
                                             r"|^[ \t]*(?:-[ \t]+)?(?:export[ \t]+)?(?:[A-Z0-9_]*(?:PASSWORD|PASSWD)|(?:[A-Z0-9_]*_)?PASS)=(['\"]?)(?!\$|\\|\{\{|<|`|%|\*{3,}|(?i:test|example|changeme|change_?me|placeholder|mysecret|secret|hunter2|s3cr3t|your[_-]?|x{3,}|\[?redacted|\w*(?:pass|secret|token)))[^'\"\s]{6,}\3(?:\s|$)"), "password literal"),
    ("pii.email",      "CRITICAL", PERSONAL_EMAIL_RE, "personal email address"),
    ("email.address",  "WARNING",  EMAIL_RE, "email address"),
    ("infra.privip",   "WARNING",  re.compile(r"\b(192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3})\b"), "private IP"),
    ("infra.pubip",    "CRITICAL", re.compile(r"(?<![/v\w.-])(?!(?:10|127|0)\.)(?!192\.0\.2\.)(?!198\.51\.100\.)(?!203\.0\.113\.)(?!93\.184\.216\.34)(?!255\.)(?!1\.1\.1\.1\b)(?!1\.0\.0\.1\b)(?!8\.8\.8\.8\b)(?!8\.8\.4\.4\b)(?!9\.9\.9\.9\b)(?!224\.0\.0\.)(?!239\.)(?!192\.168\.)(?!172\.(?:1[6-9]|2\d|3[01])\.)(?:[1-9]\d?|1\d\d|2[0-4]\d|25[0-5])(?:\.(?:\d{1,3})){3}(?![\w.-])(?<!\.0\.0\.0)"), "public IP address"),
    ("infra.ssh",      "CRITICAL", re.compile(r"\bssh\s+(-i\s+\S+\s+)?[a-z_][a-z0-9_-]*@[0-9A-Za-z.-]+"), "SSH connection string"),
    ("infra.pem",      "WARNING",  re.compile(r"(?<!\S)\S+\.pem\b"), "key file reference"),
    ("infra.hostname", "WARNING",  HOSTNAME_RE, "internal host name"),
    ("path.home",      "CRITICAL", re.compile(r"(/Users/(?!Shared/)[A-Za-z][A-Za-z0-9_-]*/|/home/(?!user/)[a-z][a-z0-9_-]*/|C:\\\\Users\\\\[A-Za-z])"), "host-specific home path"),
    ("path.secrets",   "CRITICAL", re.compile(r"(^|\s)~?/?\.secrets/"), "secrets directory reference"),
    ("cfg.entropy",    "WARNING",  re.compile(r"^[A-Z_]{4,}=[A-Za-z0-9+/=_-]{32,}$"), "high-entropy config value"),
]

DANGEROUS_FILES = [
    (re.compile(r"(^|/)\.env(\.[A-Za-z0-9_.-]+)?$"), "environment file"),
    (re.compile(r"\.(pem|key|p12|pfx|jks)$"), "key material"),
    (re.compile(r"(^|/)(credentials|service-account[^/]*)\.json$"), "credential file"),
    (re.compile(r"(^|/)\.secrets(/|$)"), "secrets directory"),
    (re.compile(r"(^|/)(dump|.*\.dump|.*\.sql\.gz)$"), "database dump"),
    (re.compile(r"\.map$"), "source map"),
]

def is_text(path, include_logs=False):
    ext = os.path.splitext(path)[1].lower()
    if ext not in TEXT_EXT and not (include_logs and ext == ".log"):   # logs only when asked
        return False
    try:
        with open(path, "rb") as f:
            chunk = f.read(4096)
        return b"\x00" not in chunk
    except OSError:
        return False

def truncate(s):
    return s[:4] + "..." if len(s) > 4 else s

def load_ignores(root):
    """Paths listed in <root>/.sanitize-ignore (one per line, relative) are skipped."""
    ig = os.path.join(root, ".sanitize-ignore")
    if not os.path.isfile(ig):
        return set()
    with open(ig) as f:
        return {l.strip() for l in f if l.strip() and not l.startswith("#")}

def scan(root, allow, include_logs=False):
    findings, files_scanned = [], 0
    ignores = set()   # absolute paths; every .sanitize-ignore under root contributes, relative to its own directory
    for dp, dns, fns in os.walk(root):
        for entry in load_ignores(dp):
            ignores.add(os.path.normpath(os.path.join(dp, entry)))
        dns[:] = [d for d in dns if d not in SKIP_DIRS and os.path.normpath(os.path.join(dp, d)) not in ignores]
        for fn in fns:
            p = os.path.join(dp, fn); rel = os.path.relpath(p, root)
            if os.path.normpath(p) in ignores or fn == ".sanitize-ignore":
                continue
            for rx, label in DANGEROUS_FILES:
                if rx.search(rel) and not fn.endswith(".example"):
                    findings.append(("file.dangerous", "CRITICAL", rel, 0, label, ""))
            if not is_text(p, include_logs):
                continue
            files_scanned += 1
            try:
                with open(p, "r", encoding="utf-8", errors="replace") as f:
                    for n, line in enumerate(f, 1):
                        if any(a.search(line) for a in allow):
                            continue
                        for pid, sev, rx, label in PATTERNS:
                            check = VALIDATORS.get(pid)
                            if check is None:
                                m = rx.search(line)
                            else:
                                # every match on the line is offered to the predicate:
                                # one rejected name must not hide a later real one
                                m = next((x for x in rx.finditer(line) if check(x, line)), None)
                            if m is None:
                                continue
                            # every pattern is tried on every line, one finding each: a warning earlier
                            # in the list must not hide a critical one later in it
                            findings.append((pid, sev, rel, n, label, truncate(m.group(0))))
            except OSError:
                pass
    return findings, files_scanned

def main():
    class _AP(argparse.ArgumentParser):
        def error(self, message):
            self.print_usage(sys.stderr); print(f"sanitize: error: {message}", file=sys.stderr); sys.exit(3)
    ap = _AP(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("dirs", nargs="+", metavar="dir", help="one or more directories to scan")
    ap.add_argument("--report")
    ap.add_argument("--allow", action="append", default=[], help="regex; matching lines are ignored")
    ap.add_argument("--include-logs", action="store_true", help="also scan .log files")
    ap.add_argument("--quiet", action="store_true")
    a = ap.parse_args()
    for d in a.dirs:
        if not os.path.isdir(d):
            print(f"sanitize: {d} is not a directory", file=sys.stderr); return 3
    allow = [re.compile(x) for x in a.allow]
    findings, n = [], 0
    for d in a.dirs:
        fs, scanned = scan(d, allow, a.include_logs)
        if len(a.dirs) > 1:   # keep paths distinguishable across directories
            base = os.path.basename(os.path.abspath(d))
            fs = [(pid, sev, os.path.join(base, rel), ln, label, snip) for pid, sev, rel, ln, label, snip in fs]
        findings += fs; n += scanned
    title = ", ".join(os.path.basename(os.path.abspath(d)) for d in a.dirs)
    crit = [f for f in findings if f[1] == "CRITICAL"]
    warn = [f for f in findings if f[1] == "WARNING"]
    verdict = "FAIL" if crit else ("PASS WITH WARNINGS" if warn else "PASS")

    by_cat = {}
    for f in findings:
        by_cat.setdefault(f[0], []).append(f)
    lines = [f"# Sanitization Report: {title}", "",
             f"**Date:** {date.today().isoformat()}  ", f"**Files scanned:** {n}  ",
             f"**Verdict:** {verdict}", "",
             "| Category | Severity | Findings | Files |", "|---|---|---|---|"]
    for pid in sorted(by_cat):
        fs = by_cat[pid]
        lines.append(f"| `{pid}` — {fs[0][4]} | {fs[0][1]} | {len(fs)} | {len({f[2] for f in fs})} |")
    lines += ["", f"## Critical findings ({len(crit)})", ""]
    for pid, sev, rel, ln, label, snip in crit[:400]:
        loc = f"{rel}:{ln}" if ln else rel
        lines.append(f"- **[{pid}]** `{loc}` — {label}" + (f" `{snip}`" if snip else ""))
    if len(crit) > 400: lines.append(f"- … {len(crit) - 400} more")
    lines += ["", f"## Warnings ({len(warn)})", ""]
    for pid, sev, rel, ln, label, snip in warn[:200]:
        lines.append(f"- **[{pid}]** `{rel}:{ln}` — {label}" + (f" `{snip}`" if snip else ""))
    if len(warn) > 200: lines.append(f"- … {len(warn) - 200} more")
    lines += ["", "## Recommendation", "",
              {"FAIL": f"Fix or remove the {len(crit)} critical findings, then re-run.",
               "PASS WITH WARNINGS": f"Clear of critical findings. Review the {len(warn)} warnings before sharing.",
               "PASS": "Clear. Safe to share."}[verdict], ""]
    report = "\n".join(lines)
    if a.report:
        with open(a.report, "w") as f: f.write(report)
    if not a.quiet:
        print(report if not a.report else f"{verdict}: {len(crit)} critical, {len(warn)} warnings across {n} files → {a.report}")
    return {"PASS": 0, "PASS WITH WARNINGS": 1, "FAIL": 2}[verdict]

if __name__ == "__main__":
    sys.exit(main())
